// Category links of the configured profiles: drop, then declare again
MATCH (p:EEHRxFProfile)-[r:PART_OF_CATEGORY]->(:EEHRxFCategory) WHERE p.profileId IN ['patient-eu-core', 'practitioner-eu-core', 'organization-eu-core', 'practitioner-role-eu-core', 'condition-eu-core', 'composition-eps-eu', 'bundle-eps-eu', 'medication-request-eu', 'medication-dispense-eu', 'imaging-study-eu', 'diagnostic-report-imaging-eu', 'diagnostic-report-lab-eu', 'observation-results-lab-eu', 'bundle-lab-report-eu', 'composition-hdr-eu', 'encounter-hdr-eu'] DELETE r;

MATCH (p:EEHRxFProfile {profileId: 'patient-eu-core'}), (c:EEHRxFCategory {categoryId: 'patient-summary'}) MERGE (p)-[:PART_OF_CATEGORY]->(c);
MATCH (p:EEHRxFProfile {profileId: 'patient-eu-core'}), (c:EEHRxFCategory {categoryId: 'laboratory-results'}) MERGE (p)-[:PART_OF_CATEGORY]->(c);
MATCH (p:EEHRxFProfile {profileId: 'patient-eu-core'}), (c:EEHRxFCategory {categoryId: 'hospital-discharge'}) MERGE (p)-[:PART_OF_CATEGORY]->(c);
MATCH (p:EEHRxFProfile {profileId: 'practitioner-eu-core'}), (c:EEHRxFCategory {categoryId: 'patient-summary'}) MERGE (p)-[:PART_OF_CATEGORY]->(c);
MATCH (p:EEHRxFProfile {profileId: 'organization-eu-core'}), (c:EEHRxFCategory {categoryId: 'patient-summary'}) MERGE (p)-[:PART_OF_CATEGORY]->(c);
MATCH (p:EEHRxFProfile {profileId: 'practitioner-role-eu-core'}), (c:EEHRxFCategory {categoryId: 'patient-summary'}) MERGE (p)-[:PART_OF_CATEGORY]->(c);
MATCH (p:EEHRxFProfile {profileId: 'condition-eu-core'}), (c:EEHRxFCategory {categoryId: 'patient-summary'}) MERGE (p)-[:PART_OF_CATEGORY]->(c);
MATCH (p:EEHRxFProfile {profileId: 'composition-eps-eu'}), (c:EEHRxFCategory {categoryId: 'patient-summary'}) MERGE (p)-[:PART_OF_CATEGORY]->(c);
MATCH (p:EEHRxFProfile {profileId: 'bundle-eps-eu'}), (c:EEHRxFCategory {categoryId: 'patient-summary'}) MERGE (p)-[:PART_OF_CATEGORY]->(c);
MATCH (p:EEHRxFProfile {profileId: 'medication-request-eu'}), (c:EEHRxFCategory {categoryId: 'eprescription'}) MERGE (p)-[:PART_OF_CATEGORY]->(c);
MATCH (p:EEHRxFProfile {profileId: 'medication-dispense-eu'}), (c:EEHRxFCategory {categoryId: 'edispensation'}) MERGE (p)-[:PART_OF_CATEGORY]->(c);
MATCH (p:EEHRxFProfile {profileId: 'imaging-study-eu'}), (c:EEHRxFCategory {categoryId: 'medical-imaging'}) MERGE (p)-[:PART_OF_CATEGORY]->(c);
MATCH (p:EEHRxFProfile {profileId: 'diagnostic-report-imaging-eu'}), (c:EEHRxFCategory {categoryId: 'medical-imaging'}) MERGE (p)-[:PART_OF_CATEGORY]->(c);
MATCH (p:EEHRxFProfile {profileId: 'diagnostic-report-lab-eu'}), (c:EEHRxFCategory {categoryId: 'laboratory-results'}) MERGE (p)-[:PART_OF_CATEGORY]->(c);
MATCH (p:EEHRxFProfile {profileId: 'observation-results-lab-eu'}), (c:EEHRxFCategory {categoryId: 'laboratory-results'}) MERGE (p)-[:PART_OF_CATEGORY]->(c);
MATCH (p:EEHRxFProfile {profileId: 'bundle-lab-report-eu'}), (c:EEHRxFCategory {categoryId: 'laboratory-results'}) MERGE (p)-[:PART_OF_CATEGORY]->(c);
MATCH (p:EEHRxFProfile {profileId: 'composition-hdr-eu'}), (c:EEHRxFCategory {categoryId: 'hospital-discharge'}) MERGE (p)-[:PART_OF_CATEGORY]->(c);
MATCH (p:EEHRxFProfile {profileId: 'encounter-hdr-eu'}), (c:EEHRxFCategory {categoryId: 'hospital-discharge'}) MERGE (p)-[:PART_OF_CATEGORY]->(c);

// Every profile builds on the EU core Patient except the Patient itself
MATCH (p:EEHRxFProfile)-[r:DEPENDS_ON]->(:EEHRxFProfile) WHERE p.profileId IN ['patient-eu-core', 'practitioner-eu-core', 'organization-eu-core', 'practitioner-role-eu-core', 'condition-eu-core', 'composition-eps-eu', 'bundle-eps-eu', 'medication-request-eu', 'medication-dispense-eu', 'imaging-study-eu', 'diagnostic-report-imaging-eu', 'diagnostic-report-lab-eu', 'observation-results-lab-eu', 'bundle-lab-report-eu', 'composition-hdr-eu', 'encounter-hdr-eu'] DELETE r;
MATCH (p:EEHRxFProfile), (dep:EEHRxFProfile {profileId: 'patient-eu-core'})
WHERE p.profileId IN ['patient-eu-core', 'practitioner-eu-core', 'organization-eu-core', 'practitioner-role-eu-core', 'condition-eu-core', 'composition-eps-eu', 'bundle-eps-eu', 'medication-request-eu', 'medication-dispense-eu', 'imaging-study-eu', 'diagnostic-report-imaging-eu', 'diagnostic-report-lab-eu', 'observation-results-lab-eu', 'bundle-lab-report-eu', 'composition-hdr-eu', 'encounter-hdr-eu'] AND p.profileId <> 'patient-eu-core' AND p.baseResource <> 'Bundle'
MERGE (p)-[:DEPENDS_ON]->(dep);

// Guides the hub plans to track that are not (yet) validated: new HL7 Europe drafts
MATCH (g:EEHRxFPlannedGuide) WHERE NOT g.guideId IN ['cancer-common', 'health-data-api', 'imaging-manifest'] DETACH DELETE g;
MERGE (g:EEHRxFPlannedGuide {guideId: 'cancer-common'})
SET g.name = 'HL7 Europe Common Cancer Model',
    g.igPackage = 'hl7.fhir.eu.cancer-common#1.0.0-ballot',
    g.status = 'Ballot',
    g.url = 'https://hl7.eu/fhir/cancer-common/1.0.0-ballot/',
    g.issue = 1145,
    g.scope = 'A cancer journey from diagnosis to follow-up, mapped to both FHIR and OMOP. Not an EHDS priority category: secondary use.';
MERGE (g:EEHRxFPlannedGuide {guideId: 'health-data-api'})
SET g.name = 'EU Health Data API',
    g.igPackage = 'hl7.fhir.eu.health-data-api#1.0.0-ballot',
    g.status = 'Ballot',
    g.url = 'https://hl7.eu/fhir/health-data-api/1.0.0-ballot/en/',
    g.issue = null,
    g.scope = 'How EHR systems provide and consume EEHRxF data: CapabilityStatement, search, Bulk export, SMART or IUA authorisation. Epic E2 of discussion #1143.';
MERGE (g:EEHRxFPlannedGuide {guideId: 'imaging-manifest'})
SET g.name = 'EU Manifest-based Access to DICOM Objects (EU-MADO)',
    g.igPackage = 'hl7.fhir.eu.imaging-manifest#1.0.0-ballot',
    g.status = 'Ballot',
    g.url = 'https://hl7.eu/fhir/imaging-manifest/1.0.0-ballot/en/',
    g.issue = null,
    g.scope = 'Access to imaging studies for the Art. 14(1)(d) category. The hub holds no imaging data yet.';

// The validation run the results above come from
MERGE (v:EEHRxFValidationRun {runId: 'current'})
SET v.igUrls = ['https://hl7.eu/fhir/base/', 'https://hl7.eu/fhir/eps/1.0.0-ballot/', 'https://hl7.eu/fhir/hdr/', 'https://hl7.eu/fhir/imaging/1.0.0-ballot/en/', 'https://hl7.eu/fhir/laboratory/', 'https://hl7.eu/fhir/mpd/'],
    v.igs = ['hl7.fhir.eu.base#2.0.1', 'hl7.fhir.eu.eps#1.0.0-ballot', 'hl7.fhir.eu.hdr#1.0.0', 'hl7.fhir.eu.imaging#1.0.0-ballot', 'hl7.fhir.eu.laboratory#2.1.0', 'hl7.fhir.eu.mpd#1.0.0'],
    v.inputsDigest = 'd9f3a463ba74b578',
    v.maxPerSource = 20,
    v.passRule = 'a resource passes when the validator reports no error or fatal issue',
    v.sources = ['klarbefund: Golden bundles of the shared FHIR writer (Klarbefund iPhone app and services/epa-ingest)', 'synthea: Seeded Synthea sample, cut to the resource types scripts/load_fhir_neo4j.py loads'],
    v.terminology = 'not checked: run with -tx n/a, so codes are checked for shape, not against SNOMED CT, LOINC or the IG value sets',
    v.validatorUrl = 'https://github.com/hapifhir/org.hl7.fhir.core/releases/tag/7.0.5',
    v.validatorVersion = '7.0.5';

// Graph nodes per base type, for context (not coverage)
OPTIONAL MATCH (n:Bundle) WITH count(n) AS cnt
MATCH (p:EEHRxFProfile {baseResource: 'Bundle'}) SET p.resourceCount = cnt;
OPTIONAL MATCH (n:Composition) WITH count(n) AS cnt
MATCH (p:EEHRxFProfile {baseResource: 'Composition'}) SET p.resourceCount = cnt;
OPTIONAL MATCH (n:Condition) WITH count(n) AS cnt
MATCH (p:EEHRxFProfile {baseResource: 'Condition'}) SET p.resourceCount = cnt;
OPTIONAL MATCH (n:DiagnosticReport) WITH count(n) AS cnt
MATCH (p:EEHRxFProfile {baseResource: 'DiagnosticReport'}) SET p.resourceCount = cnt;
OPTIONAL MATCH (n:Encounter) WITH count(n) AS cnt
MATCH (p:EEHRxFProfile {baseResource: 'Encounter'}) SET p.resourceCount = cnt;
OPTIONAL MATCH (n:ImagingStudy) WITH count(n) AS cnt
MATCH (p:EEHRxFProfile {baseResource: 'ImagingStudy'}) SET p.resourceCount = cnt;
OPTIONAL MATCH (n:MedicationDispense) WITH count(n) AS cnt
MATCH (p:EEHRxFProfile {baseResource: 'MedicationDispense'}) SET p.resourceCount = cnt;
OPTIONAL MATCH (n:MedicationRequest) WITH count(n) AS cnt
MATCH (p:EEHRxFProfile {baseResource: 'MedicationRequest'}) SET p.resourceCount = cnt;
OPTIONAL MATCH (n:Observation) WITH count(n) AS cnt
MATCH (p:EEHRxFProfile {baseResource: 'Observation'}) SET p.resourceCount = cnt;
OPTIONAL MATCH (n:Organization) WITH count(n) AS cnt
MATCH (p:EEHRxFProfile {baseResource: 'Organization'}) SET p.resourceCount = cnt;
OPTIONAL MATCH (n:Patient) WITH count(n) AS cnt
MATCH (p:EEHRxFProfile {baseResource: 'Patient'}) SET p.resourceCount = cnt;
OPTIONAL MATCH (n:Practitioner) WITH count(n) AS cnt
MATCH (p:EEHRxFProfile {baseResource: 'Practitioner'}) SET p.resourceCount = cnt;
OPTIONAL MATCH (n:PractitionerRole) WITH count(n) AS cnt
MATCH (p:EEHRxFProfile {baseResource: 'PractitionerRole'}) SET p.resourceCount = cnt;

MATCH (c:EEHRxFCategory)
OPTIONAL MATCH (c)<-[:PART_OF_CATEGORY]-(p:EEHRxFProfile)
WITH c, sum(coalesce(p.resourceCount, 0)) AS total
SET c.totalResources = total;
