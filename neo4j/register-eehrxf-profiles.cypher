// ============================================================
// EEHRxF priority categories, HL7 Europe profiles and validation results
// ============================================================
// GENERATED by scripts/eehrxf/build.py from scripts/eehrxf/profiles.json
// and scripts/eehrxf/validation-report.json. Do not edit by hand (#1144).
//
// Categories are the six of EHDS Art. 14(1), Regulation (EU) 2025/327.
// coverage comes from the HL7 FHIR Validator, not from counting nodes:
//   full = every tested resource passes, partial = some do, none = none do,
//   untested = the hub ingests nothing of that type. resourceCount is the
//   number of graph nodes of the base type, shown for context only.
//
// Run after: init-schema.cypher. Idempotent.
// ============================================================

// Categories the config no longer lists (rare-disease registries were never an Art. 14 category)
MATCH (c:EEHRxFCategory) WHERE NOT c.categoryId IN ['patient-summary', 'eprescription', 'edispensation', 'medical-imaging', 'laboratory-results', 'hospital-discharge']
DETACH DELETE c;

// Profiles the config no longer lists
MATCH (p:EEHRxFProfile) WHERE p.profileId IS NOT NULL AND NOT p.profileId IN ['patient-eu-core', 'practitioner-eu-core', 'organization-eu-core', 'practitioner-role-eu-core', 'condition-eu-core', 'composition-eps-eu', 'bundle-eps-eu', 'medication-request-eu', 'medication-dispense-eu', 'imaging-study-eu', 'diagnostic-report-imaging-eu', 'diagnostic-report-lab-eu', 'observation-results-lab-eu', 'bundle-lab-report-eu', 'composition-hdr-eu', 'encounter-hdr-eu']
DETACH DELETE p;

