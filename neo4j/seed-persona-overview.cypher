  {id: 'obs-p1-2339-0-2024-09-12', code: '2339-0', display: 'Glucose [Mass/volume] in Blood', unit: 'mg/dL', value: 118, low: 70, high: 99, category: 'laboratory', at: '2024-09-12'},
  {id: 'obs-p1-2339-0-2025-01-20', code: '2339-0', display: 'Glucose [Mass/volume] in Blood', unit: 'mg/dL', value: 124, low: 70, high: 99, category: 'laboratory', at: '2025-01-20'},
