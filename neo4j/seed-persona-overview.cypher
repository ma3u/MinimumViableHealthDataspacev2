UNWIND [
  {id: 'obs-p1-4548-4-2024-09-12', code: '4548-4', display: 'Hemoglobin A1c/Hemoglobin.total in Blood', unit: '%', value: 6.4, low: 4.0, high: 6.0, category: 'laboratory', at: '2024-09-12'},
