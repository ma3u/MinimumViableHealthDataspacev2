// ============================================================
// Persona overview seed (discussion #265, issue #271): the data the four persona
// views need, and the relations between the personas.
//
//   patient P1 (Maria Schmidt, the patient1 login) -TREATED_AT-> AlphaKlinik Berlin (holder)
//     -HAS_ENCOUNTER-> one laboratory visit per measurement date
//     -HAS_OBSERVATION-> 48 LOINC-coded measurements with reference ranges
//     -HAS_CONDITION / HAS_MEDICATION_REQUEST-> her record
//     -GAVE_CONSENT-> PatientConsent -FOR_STUDY-> ResearchStudy
//   ResearchStudy <-CONDUCTS- Participant (PharmaCo, IRS, MedReg)
//     -HAS_ENROLMENT-> StudyEnrolment, one per quarter
//   TransferEvent, one per access, twelve months, per consumer and dataset
//     -READ-> Patient for the reads that touched P1's record (Art. 8 log)
//     -REQUESTED_BY-> consumer, -PROVIDED_BY-> AlphaKlinik, -ACCESSED-> dataset,
//     -UNDER_PERMIT-> HDABApproval (issued by MedReg DE / IRS)
//   VerifiableCredential (quality label) -HAS_ASSESSMENT-> QualityAssessment
//     -ASSESSES-> dataset, one per quarter
//
// Generated by scripts/generate-persona-overview-seed.py. Do not edit by
// hand; change the generator and run it. Fictional data only. Idempotent
// MERGE throughout. Run after seed-compliance-matrix.cypher.
// ============================================================

// ── 1. The demo patient, treated at AlphaKlinik Berlin ──────────────────────
MERGE (p:Patient {resourceId: 'P1'})
SET p.id = 'P1',
    p.name = 'Maria Schmidt',
    p.gender = 'female',
    p.birthDate = date('1979-03-15'),
    p.city = 'Berlin',
    p.country = 'DE',
    p.demo = true,
    p.fictional = true
WITH p
MATCH (holder:Participant {participantId: 'did:web:alpha-klinik.de:participant'})
MERGE (p)-[:TREATED_AT]->(holder)
WITH p
MATCH (ds:HealthDataset {datasetId: 'dataset:synthea-fhir-r4-mvd'})
MERGE (p)-[:FROM_DATASET]->(ds);

// ── 2. Her diagnoses and medications (as in patient_profile_patient1.json) ──
MATCH (p:Patient {resourceId: 'P1'})
UNWIND [
  {id: 'cond-p1-73211009', code: '73211009', system: 'http://snomed.info/sct', display: 'Diabetes mellitus type 2', onset: '2018-04-10'},
  {id: 'cond-p1-38341003', code: '38341003', system: 'http://snomed.info/sct', display: 'Hypertension', onset: '2015-11-02'},
  {id: 'cond-p1-73595000', code: '73595000', system: 'http://snomed.info/sct', display: 'Stress (finding)', onset: '2020-01-15'},
  {id: 'cond-p1-E11.9', code: 'E11.9', system: 'http://hl7.org/fhir/sid/icd-10', display: 'T2D without complications', onset: '2018-04-10'},
  {id: 'cond-p1-414916001', code: '414916001', system: 'http://snomed.info/sct', display: 'Obesity (BMI 31.2)', onset: '2017-06-20'},
  {id: 'cond-p1-271825005', code: '271825005', system: 'http://snomed.info/sct', display: 'Respiratory distress', onset: '2021-03-08'},
  {id: 'cond-p1-40055000', code: '40055000', system: 'http://snomed.info/sct', display: 'Chronic sinusitis', onset: '2013-09-14'},
  {id: 'cond-p1-195967001', code: '195967001', system: 'http://snomed.info/sct', display: 'Asthma', onset: '2009-02-27'}
] AS c
MERGE (cond:Condition {resourceId: c.id})
SET cond.code = c.code,
    cond.codeSystem = c.system,
    cond.display = c.display,
    cond.name = c.display,
    cond.clinicalStatus = 'active',
    cond.onsetDate = c.onset,
    cond.fictional = true
MERGE (p)-[:HAS_CONDITION]->(cond);

MATCH (p:Patient {resourceId: 'P1'})
UNWIND [
  {id: 'med-p1-860975', code: '860975', display: 'Metformin 500 mg oral tablet', since: '2018-04-10'},
  {id: 'med-p1-197361', code: '197361', display: 'Lisinopril 10 mg oral tablet', since: '2015-11-02'},
  {id: 'med-p1-308460', code: '308460', display: 'Salbutamol 100 mcg inhaler', since: '2009-02-27'},
  {id: 'med-p1-209459', code: '209459', display: 'Atorvastatin 20 mg oral tablet', since: '2024-09-12'}
] AS m
MERGE (med:MedicationRequest {resourceId: m.id})
SET med.medicationCode = m.code,
    med.code = m.code,
    med.codeSystem = 'http://www.nlm.nih.gov/research/umls/rxnorm',
    med.display = m.display,
    med.name = m.display,
    med.status = 'active',
    med.intent = 'order',
    med.date = m.since,
    med.fictional = true
MERGE (p)-[:HAS_MEDICATION_REQUEST]->(med);

// ── 2b. Her visits: one laboratory visit per measurement date ─────────────
MATCH (p:Patient {resourceId: 'P1'})
UNWIND [
  {id: 'enc-p1-2024-09-12', at: '2024-09-12', n: 1},
  {id: 'enc-p1-2025-01-20', at: '2025-01-20', n: 2},
  {id: 'enc-p1-2025-05-15', at: '2025-05-15', n: 3},
  {id: 'enc-p1-2025-09-18', at: '2025-09-18', n: 4},
  {id: 'enc-p1-2026-02-10', at: '2026-02-10', n: 5},
  {id: 'enc-p1-2026-08-21', at: '2026-08-21', n: 6}
] AS e
MERGE (enc:Encounter {resourceId: e.id})
SET enc.name = 'Laboratory visit ' + toString(e.n) + ' of 6',
    enc.display = 'Laboratory visit, AlphaKlinik Berlin (fictional)',
    enc.class = 'ambulatory',
    enc.status = 'finished',
    enc.date = e.at + 'T08:00:00Z',
    enc.period = e.at,
    enc.serviceProvider = 'AlphaKlinik Berlin',
    enc.fictional = true
MERGE (p)-[:HAS_ENCOUNTER]->(enc);

// ── 3. Her measurements: 8 LOINC parameters, 6 visits, lab reference ranges ─
// The values behind the risk scores of the profile: HbA1c and glucose drift
// up, LDL falls under atorvastatin, blood pressure improves under lisinopril,
// eGFR slips below the range. Art. 14 priority category: laboratory results.
