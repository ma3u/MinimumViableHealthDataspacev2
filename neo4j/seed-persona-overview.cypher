  {id: 'obs-p1-39156-5-2024-09-12', code: '39156-5', display: 'Body mass index (BMI) [Ratio]', unit: 'kg/m2', value: 30.4, low: 18.5, high: 25.0, category: 'vital-signs', at: '2024-09-12'},
  {id: 'obs-p1-39156-5-2025-01-20', code: '39156-5', display: 'Body mass index (BMI) [Ratio]', unit: 'kg/m2', value: 30.8, low: 18.5, high: 25.0, category: 'vital-signs', at: '2025-01-20'},
