  {id: 'STUDY-DIAB-2023:2026-09-23', study: 'STUDY-DIAB-2023', at: '2026-09-23', participants: 2103},
  {id: 'STUDY-RESP-2025:2024-06-30', study: 'STUDY-RESP-2025', at: '2024-06-30', participants: 0},
  {id: 'STUDY-RESP-2025:2024-09-30', study: 'STUDY-RESP-2025', at: '2024-09-30', participants: 0},
  {id: 'STUDY-RESP-2025:2024-12-31', study: 'STUDY-RESP-2025', at: '2024-12-31', participants: 0},
  {id: 'STUDY-RESP-2025:2025-03-31', study: 'STUDY-RESP-2025', at: '2025-03-31', participants: 0},
  {id: 'STUDY-RESP-2025:2025-06-30', study: 'STUDY-RESP-2025', at: '2025-06-30', participants: 0},
  {id: 'STUDY-RESP-2025:2025-09-30', study: 'STUDY-RESP-2025', at: '2025-09-30', participants: 0},
  {id: 'STUDY-RESP-2025:2025-12-31', study: 'STUDY-RESP-2025', at: '2025-12-31', participants: 120},
  {id: 'STUDY-RESP-2025:2026-03-31', study: 'STUDY-RESP-2025', at: '2026-03-31', participants: 340},
  {id: 'STUDY-RESP-2025:2026-06-30', study: 'STUDY-RESP-2025', at: '2026-06-30', participants: 610},
  {id: 'STUDY-RESP-2025:2026-09-23', study: 'STUDY-RESP-2025', at: '2026-09-23', participants: 890}
] AS e
MATCH (st:ResearchStudy {studyId: e.study})
MERGE (en:StudyEnrolment {enrolmentId: e.id})
SET en.asOf = date(e.at),
    en.participants = e.participants,
    en.studyId = e.study
MERGE (st)-[:HAS_ENROLMENT]->(en);

// ── 5. The patient's consents (Art. 71 opt-out state per study) ─────────────
MATCH (p:Patient {resourceId: 'P1'})
UNWIND [
  {id: 'CONSENT-001', study: 'STUDY-CARDIO-2024', at: '2024-03-10T09:00:00Z', scope: 'FHIR Conditions + Observations', tc: 'MedReg DE Trust Centre', revokedAt: null},
  {id: 'CONSENT-002', study: 'STUDY-DIAB-2023', at: '2023-11-15T14:30:00Z', scope: 'OMOP Drug Exposures + Conditions', tc: 'Limburg Trust Centre NL', revokedAt: null},
  {id: 'CONSENT-003', study: 'STUDY-RESP-2025', at: '2026-01-12T10:00:00Z', scope: 'FHIR Conditions + spirometry Observations', tc: 'MedReg DE Trust Centre', revokedAt: '2026-05-01T08:00:00Z'}
] AS c
MERGE (pc:PatientConsent {consentId: c.id})
SET pc.patientId = 'P1',
    pc.studyId = c.study,
    pc.grantedAt = datetime(c.at),
    pc.revoked = c.revokedAt IS NOT NULL,
    pc.revokedAt = CASE WHEN c.revokedAt IS NULL THEN null ELSE datetime(c.revokedAt) END,
    pc.purpose = 'secondary-use',
    pc.dataScope = c.scope,
    pc.ehdsArticle = 'Art. 71',
    pc.fictional = true
MERGE (p)-[:GAVE_CONSENT]->(pc)
WITH pc, c
MATCH (st:ResearchStudy {studyId: c.study})
MERGE (pc)-[:FOR_STUDY]->(st)
WITH pc, c
OPTIONAL MATCH (tc:TrustCenter {name: c.tc})
FOREACH (_ IN CASE WHEN tc IS NOT NULL THEN [1] ELSE [] END | MERGE (pc)-[:RESOLVED_BY]->(tc));

