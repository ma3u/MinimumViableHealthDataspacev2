  {id: 'obs-p1-33914-3-2025-01-20', code: '33914-3', display: 'Glomerular filtration rate/1.73 sq M.predicted', unit: 'mL/min/{1.73_m2}', value: 94, low: 90, high: null, category: 'laboratory', at: '2025-01-20'},
  {id: 'obs-p1-33914-3-2025-05-15', code: '33914-3', display: 'Glomerular filtration rate/1.73 sq M.predicted', unit: 'mL/min/{1.73_m2}', value: 93, low: 90, high: null, category: 'laboratory', at: '2025-05-15'},
  {id: 'obs-p1-33914-3-2025-09-18', code: '33914-3', display: 'Glomerular filtration rate/1.73 sq M.predicted', unit: 'mL/min/{1.73_m2}', value: 91, low: 90, high: null, category: 'laboratory', at: '2025-09-18'},
  {id: 'obs-p1-33914-3-2026-02-10', code: '33914-3', display: 'Glomerular filtration rate/1.73 sq M.predicted', unit: 'mL/min/{1.73_m2}', value: 90, low: 90, high: null, category: 'laboratory', at: '2026-02-10'},
  {id: 'obs-p1-33914-3-2026-08-21', code: '33914-3', display: 'Glomerular filtration rate/1.73 sq M.predicted', unit: 'mL/min/{1.73_m2}', value: 88, low: 90, high: null, category: 'laboratory', at: '2026-08-21'}
] AS o
MERGE (obs:Observation {resourceId: o.id})
SET obs.code = o.code,
    obs.codeSystem = 'http://loinc.org',
    obs.display = o.display,
    obs.name = o.display + ' ' + toString(o.value) + ' ' + o.unit,
    obs.status = 'final',
    obs.category = o.category,
    obs.valueQuantity = o.value,
    obs.value = o.value,
    obs.unit = o.unit,
    obs.valueUnit = o.unit,
    obs.referenceLow = o.low,
    obs.referenceHigh = o.high,
    obs.referenceText = CASE WHEN o.high IS NULL THEN '> ' + toString(o.low) ELSE toString(o.low) + ' - ' + toString(o.high) END + ' ' + o.unit + ' (as printed on the report)',
    obs.effectiveDate = date(o.at),
    obs.dateTime = o.at + 'T08:30:00Z',
    obs.performer = 'AlphaKlinik Berlin, Zentrallabor (fictional)',
    obs.fictional = true
MERGE (p)-[:HAS_OBSERVATION]->(obs)
WITH p, obs, o
MATCH (enc:Encounter {resourceId: 'enc-p1-' + o.at})
MERGE (obs)-[:PART_OF]->(enc)
WITH obs, o
MERGE (lc:LoincCode {loincNumber: o.code})
  ON CREATE SET lc.name = o.display + ' (LOINC ' + o.code + ')',
                lc.longCommonName = o.display
MERGE (obs)-[:CODED_BY]->(lc);

// ── 4. Studies, who conducts them, enrolment per quarter ────────────────────
UNWIND [
  {id: 'STUDY-CARDIO-2024', name: 'European Cardiovascular Risk Study', inst: 'did:web:pharmaco.de:research', status: 'open', dataNeeded: 'FHIR Conditions, Observations (blood pressure, cholesterol), Medications', countries: ['DE', 'NL', 'FR', 'ES'], ethics: 'EK-Berlin-2024-0041', participants: 4821},
  {id: 'STUDY-DIAB-2023', name: 'T2D Progression Biomarkers', inst: 'did:web:irs.fr:hdab', status: 'open', dataNeeded: 'OMOP Drug Exposures, Condition Occurrences, Measurements (HbA1c, eGFR)', countries: ['FR', 'DE', 'BE'], ethics: 'CPP-IDF-2023-0178', participants: 2103},
  {id: 'STUDY-RESP-2025', name: 'Respiratory EHDS Cohort', inst: 'did:web:medreg.de:hdab', status: 'recruiting', dataNeeded: 'FHIR Conditions (asthma, COPD), Observation spirometry values', countries: ['DE', 'AT', 'CH'], ethics: 'MedReg-EK-2025-0022', participants: 890}
] AS s
MERGE (st:ResearchStudy {studyId: s.id})
SET st.name = s.name,
    st.studyName = s.name,
    st.institutionDid = s.inst,
    st.purpose = 'secondary-use',
    st.ehdsArticle = 'Art. 53(1)(e)',
    st.status = s.status,
    st.dataNeeded = s.dataNeeded,
    st.countries = s.countries,
    st.ethicsApproval = s.ethics,
    st.participantCount = s.participants,
    st.fictional = true
WITH st, s
MATCH (inst:Participant {participantId: s.inst})
MERGE (inst)-[:CONDUCTS]->(st);

