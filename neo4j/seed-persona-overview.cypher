  {id: 'te-m-irs-prostate-2026-09-01', ts: '2026-09-02T08:15:00Z', ep: '/fhir/Patient', m: 'GET', sc: 403, n: 0, b: 180, dur: 90, ct: 'application/json', c: 'did:web:irs.fr:hdab', p: 'did:web:alpha-klinik.de:participant', ds: 'dataset:prostate-cancer-registry', permit: null, contract: null, purpose: 'PUBLIC_HEALTH', name: 'Institut de Recherche Santé is refused: no permit for the registry', reads: []},
  {id: 'te-m-irs-prostate-2026-09-02', ts: '2026-09-09T11:15:00Z', ep: '/fhir/Patient', m: 'GET', sc: 403, n: 0, b: 317, dur: 143, ct: 'application/json', c: 'did:web:irs.fr:hdab', p: 'did:web:alpha-klinik.de:participant', ds: 'dataset:prostate-cancer-registry', permit: null, contract: null, purpose: 'PUBLIC_HEALTH', name: 'Institut de Recherche Santé is refused: no permit for the registry', reads: []}
] AS e
MERGE (te:TransferEvent {eventId: e.id})
SET te.name = e.name,
    te.endpoint = e.ep,
    te.method = e.m,
    te.timestamp = datetime(e.ts),
    te.statusCode = e.sc,
    te.resultCount = e.n,
    te.responseBytes = e.b,
    te.duration = e.dur,
    te.contentType = e.ct,
    te.protocol = 'HTTP-PULL',
    te.participant = e.c,
    te.consumerDid = e.c,
    te.providerDid = e.p,
    te.datasetId = e.ds,
    te.permitId = e.permit,
    te.contractId = e.contract,
    te.purpose = e.purpose,
    te.errorMessage = CASE WHEN e.sc = 403 THEN 'No data permit covers this access (Art. 61(1))' ELSE null END,
    te.patientIds = e.reads,
    te.demo = true,
    te.monthly = true
FOREACH (pid IN e.reads | MERGE (pat:Patient {resourceId: pid}) MERGE (te)-[:READ]->(pat))
WITH te, e
OPTIONAL MATCH (c:Participant {participantId: e.c})
FOREACH (_ IN CASE WHEN c IS NOT NULL THEN [1] ELSE [] END | MERGE (te)-[:REQUESTED_BY]->(c))
WITH te, e
OPTIONAL MATCH (p:Participant {participantId: e.p})
FOREACH (_ IN CASE WHEN p IS NOT NULL THEN [1] ELSE [] END | MERGE (te)-[:PROVIDED_BY]->(p))
WITH te, e
OPTIONAL MATCH (ds:HealthDataset {datasetId: e.ds})
FOREACH (_ IN CASE WHEN ds IS NOT NULL THEN [1] ELSE [] END | MERGE (te)-[:ACCESSED]->(ds))
WITH te, e
OPTIONAL MATCH (permit:HDABApproval) WHERE e.permit IS NOT NULL AND permit.approvalId = e.permit
FOREACH (_ IN CASE WHEN permit IS NOT NULL THEN [1] ELSE [] END | MERGE (te)-[:UNDER_PERMIT]->(permit))
WITH te, e
OPTIONAL MATCH (ctr:Contract) WHERE e.contract IS NOT NULL AND ctr.contractId = e.contract
FOREACH (_ IN CASE WHEN ctr IS NOT NULL THEN [1] ELSE [] END | MERGE (te)-[:UNDER]->(ctr));

// ── 7. Quality label assessments per quarter (Art. 78) ──────────────────────
// The assessor renews the label while conformance stays in 0.90 to 1.00.
// AlphaKlinik's score has fallen below that band; the label expired.
UNWIND [
  {id: 'qa:clinic-alphaklinik:2024-Q4', period: '2024-Q4', at: '2024-12-31', conformance: 0.95, completeness: 0.9, timeliness: 0.94},
  {id: 'qa:clinic-alphaklinik:2025-Q1', period: '2025-Q1', at: '2025-03-31', conformance: 0.94, completeness: 0.9, timeliness: 0.94},
  {id: 'qa:clinic-alphaklinik:2025-Q2', period: '2025-Q2', at: '2025-06-30', conformance: 0.93, completeness: 0.89, timeliness: 0.93},
  {id: 'qa:clinic-alphaklinik:2025-Q3', period: '2025-Q3', at: '2025-09-30', conformance: 0.92, completeness: 0.89, timeliness: 0.93},
  {id: 'qa:clinic-alphaklinik:2025-Q4', period: '2025-Q4', at: '2025-12-31', conformance: 0.91, completeness: 0.88, timeliness: 0.92},
  {id: 'qa:clinic-alphaklinik:2026-Q1', period: '2026-Q1', at: '2026-03-31', conformance: 0.9, completeness: 0.88, timeliness: 0.92},
  {id: 'qa:clinic-alphaklinik:2026-Q2', period: '2026-Q2', at: '2026-06-30', conformance: 0.89, completeness: 0.87, timeliness: 0.91},
  {id: 'qa:clinic-alphaklinik:2026-Q3', period: '2026-Q3', at: '2026-09-23', conformance: 0.88, completeness: 0.86, timeliness: 0.91}
] AS a
MERGE (qa:QualityAssessment {assessmentId: a.id})
SET qa.period = a.period,
    qa.assessedAt = date(a.at),
    qa.conformance = a.conformance,
    qa.completeness = a.completeness,
    qa.timeliness = a.timeliness,
    qa.renewalBandLow = 0.90,
    qa.renewalBandHigh = 1.00,
    qa.assessor = 'MedReg DE Quality Assessment Unit',
    qa.ehdsArticle = 'Art. 78',
    qa.fictional = true
WITH qa
MATCH (vc:VerifiableCredential {credentialId: 'vc:data-quality-label:clinic-alphaklinik'})
MERGE (vc)-[:HAS_ASSESSMENT]->(qa)
WITH qa
MATCH (ds:HealthDataset {datasetId: 'dataset:synthea-fhir-r4-mvd'})
MERGE (qa)-[:ASSESSES]->(ds);

// ── 8. Repair: a credential past its expiry is not 'active' ────────────────
// The credential fixtures keep status 'active' after expiresAt; anything that
// trusts the flag is wrong (discussion #265). Derive it from the date.
MATCH (vc:VerifiableCredential)
WHERE vc.expiresAt IS NOT NULL AND datetime(toString(vc.expiresAt)) < datetime()
  AND coalesce(vc.status, 'active') = 'active'
SET vc.status = 'expired';

// ── 9. Pin the credential dates the stories rest on ─────────────────────────
// The credential seed dates expiry relative to its run; the overview stories
// need PharmaCo's purpose credential expired on 2026-06-20 (accesses after it)
// and the two quality labels expired on 2026-09-18 (Art. 78 renewal due).
MATCH (vc:VerifiableCredential {credentialId: 'vc:data-processing-purpose:cro-pharmaco'})
SET vc.expiresAt = datetime('2026-06-20T00:06:57Z'), vc.status = 'expired';
MATCH (vc:VerifiableCredential)
WHERE vc.credentialId IN ['vc:data-quality-label:clinic-alphaklinik', 'vc:data-quality-label:clinic-lmc']
SET vc.expiresAt = datetime('2026-09-18T00:06:57Z'), vc.status = 'expired';
