UNWIND [
  {nedrexId: 'mondo.0000001', mondoId: 'MONDO:0000001', name: 'disease', description: 'A disease is a disposition to undergo pathological processes that exists in an organism because of one or more disorders in that organism.', icd10: [], snomedCodes: ['64572001'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0000270', mondoId: 'MONDO:0000270', name: 'lower respiratory tract disorder', description: 'A disease involving the lower respiratory tract.', icd10: [], snomedCodes: ['128272009'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0000387', mondoId: 'MONDO:0000387', name: 'hypochromic microcytic anemia', description: 'Anemia in which the circulating RBCs are smaller than the usual size of RBCs (microcytic) and have decreased red color (hypochromic).', icd10: [], snomedCodes: ['44666001'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0000473', mondoId: 'MONDO:0000473', name: 'arterial disorder', description: 'An impairment of the structure or function of the blood vessels which carry blood away from the heart.', icd10: [], snomedCodes: ['359557001'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0000589', mondoId: 'MONDO:0000589', name: 'autoimmune disorder of musculoskeletal system', description: 'A hypersensitivity reaction type II disease that involves the musculoskeletal system.', icd10: [], snomedCodes: [], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0001245', mondoId: 'MONDO:0001245', name: 'microcytic anemia', description: 'Anemia in which the red blood cell volume is decreased.', icd10: [], snomedCodes: ['234349007'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0001356', mondoId: 'MONDO:0001356', name: 'iron deficiency anemia', description: 'Anemia caused by low iron intake, inefficient iron absorption in the gastrointestinal tract, or chronic blood loss.', icd10: ['D50'], snomedCodes: ['87522002'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0001357', mondoId: 'MONDO:0001357', name: 'hypochromic anemia', description: 'Anemia caused by the reduction of hemoglobin in relation to the red cell volume. As a result, the red cells have an area of central pallor which is increased in size. The leading cause is iron deficiency.', icd10: [], snomedCodes: ['44452003'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0001358', mondoId: 'MONDO:0001358', name: 'bronchial disorder', description: 'A disease involving the bronchus.', icd10: [], snomedCodes: ['41427001'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0001735', mondoId: 'MONDO:0001735', name: 'paranasal sinus disorder', description: 'A disease involving the paranasal sinus.', icd10: [], snomedCodes: ['7393007'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0001933', mondoId: 'MONDO:0001933', name: 'endocrine pancreas disorder', description: 'A disease involving the endocrine pancreas.', icd10: [], snomedCodes: ['17346000'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0002025', mondoId: 'MONDO:0002025', name: 'psychiatric disorder', description: 'A disorder characterized by behavioral and/or psychological abnormalities, often accompanied by physical symptoms. The symptoms may cause clinically significant distress or impairment in social and occupational areas of functioning. Representative examples include anxiety disorders, cognitive disorders, mood disorders and schizophrenia.', icd10: [], snomedCodes: [], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0002050', mondoId: 'MONDO:0002050', name: 'depressive disorder', description: 'A melancholy feeling of sadness and despair.', icd10: [], snomedCodes: ['35489007'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0002081', mondoId: 'MONDO:0002081', name: 'musculoskeletal system disorder', description: 'A disease involving the musculoskeletal system.', icd10: [], snomedCodes: ['928000'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0002118', mondoId: 'MONDO:0002118', name: 'urinary system disorder', description: 'A disease involving the renal system.', icd10: [], snomedCodes: ['128606002'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0002149', mondoId: 'MONDO:0002149', name: 'reproductive system cancer', description: 'A malignant neoplasm involving the reproductive organ', icd10: [], snomedCodes: [], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0002267', mondoId: 'MONDO:0002267', name: 'obstructive lung disease', description: 'Any disorder marked by obstruction of conducting airways of the lung. airway obstruction may be acute, chronic, intermittent, or persistent.', icd10: [], snomedCodes: [], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0002280', mondoId: 'MONDO:0002280', name: 'anemia', description: 'A reduction in the number of red blood cells, the amount of hemoglobin, and/or the volume of packed red blood cells. Clinically, anemia represents a reduction in the oxygen-transporting capacity of a designated volume of blood, resulting from an imbalance between blood loss (through hemorrhage or hemolysis) and blood production. Signs and symptoms of anemia may include pallor of the skin and mucous membranes, shortness of breath, palpitations of the heart, soft systolic murmurs, lethargy, and fatigability.', icd10: [], snomedCodes: ['271737000'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0002356', mondoId: 'MONDO:0002356', name: 'pancreas disorder', description: 'A non-neoplastic or neoplastic disorder that affects the pancreas. Representative examples of non-neoplastic disorders include pancreatitis and pancreatic insufficiency. Representative examples of neoplastic disorders include cystadenomas, carcinomas, lymphomas, and neuroendocrine neoplasms.', icd10: [], snomedCodes: ['3855007'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0002436', mondoId: 'MONDO:0002436', name: 'nasal disorder', description: 'A disease involving the nose.', icd10: [], snomedCodes: ['89488007'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0002516', mondoId: 'MONDO:0002516', name: 'digestive system cancer', description: 'A primary or metastatic malignant neoplasm involving any part of the digestive system.', icd10: [], snomedCodes: [], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0002567', mondoId: 'MONDO:0002567', name: 'tracheal disorder', description: 'A non-neoplastic or neoplastic disorder that affects the trachea. Representative examples of non-neoplastic disorders include congenital malformations and infection. Representative examples of neoplastic disorders include carcinoma and lymphoma.', icd10: [], snomedCodes: ['47125007'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0002602', mondoId: 'MONDO:0002602', name: 'central nervous system disorder', description: 'A disease involving the central nervous system.', icd10: [], snomedCodes: ['23853001'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0002614', mondoId: 'MONDO:0002614', name: 'bone inflammation disease', description: 'Inflammation of the bone.', icd10: [], snomedCodes: ['274144001'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0002657', mondoId: 'MONDO:0002657', name: 'breast disorder', description: 'A disease involving the breast.', icd10: [], snomedCodes: ['79604008'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0002908', mondoId: 'MONDO:0002908', name: 'glucose metabolism disease', description: 'A metabolic disorder characterized by abnormal blood glucose levels.', icd10: [], snomedCodes: ['126877002'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0003105', mondoId: 'MONDO:0003105', name: 'prostate disorder', description: 'A disease involving the prostate gland.', icd10: [], snomedCodes: ['30281009'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0003150', mondoId: 'MONDO:0003150', name: 'male reproductive system disorder', description: 'A disease involving the male reproductive system.', icd10: [], snomedCodes: ['363194005'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0003240', mondoId: 'MONDO:0003240', name: 'thyroid gland disorder', description: 'A disease involving the thyroid gland.', icd10: [], snomedCodes: ['14304000'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0003274', mondoId: 'MONDO:0003274', name: 'thoracic cancer', description: 'A primary or metastatic malignant neoplasm affecting the tissues of the thorax.', icd10: ['C76.1'], snomedCodes: ['188361007'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0003406', mondoId: 'MONDO:0003406', name: 'sleep-wake disorder', description: 'Abnormal sleep-wake schedule or pattern associated with the circadian rhythm which affect the length, timing, and/or rigidity of the sleep-wake cycle relative to the day-night cycle. These can include dyssomnias such as circadian rhythm disorders, hypersomnia, and sleep apnea and parasomnias such as bruxism and rapid eye movement sleep disorder.', icd10: ['G47'], snomedCodes: ['39898005'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0003409', mondoId: 'MONDO:0003409', name: 'colonic disorder', description: 'Pathological processes in the colon region of the large intestine (intestine, large).', icd10: [], snomedCodes: ['128524007'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0003847', mondoId: 'MONDO:0003847', name: 'hereditary disease', description: 'A disease that is caused by genetic modifications where those modifications are inherited from a parent\'s genome.', icd10: [], snomedCodes: ['32895009'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0003900', mondoId: 'MONDO:0003900', name: 'connective tissue disorder', description: 'A disease involving the connective tissue.', icd10: [], snomedCodes: ['105969002'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0003916', mondoId: 'MONDO:0003916', name: 'overnutrition', description: 'An imbalanced nutritional status resulting from excessive intake of nutrients. Generally, overnutrition generates an energy imbalance between food consumption and energy expenditure leading to disorders such as obesity.', icd10: [], snomedCodes: ['302872003'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0004335', mondoId: 'MONDO:0004335', name: 'digestive system disorder', description: 'A disease or disorder that involves the digestive system.', icd10: [], snomedCodes: ['53619000'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0004867', mondoId: 'MONDO:0004867', name: 'upper respiratory tract disorder', description: 'A disease involving the upper respiratory tract.', icd10: [], snomedCodes: ['201060008'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0004979', mondoId: 'MONDO:0004979', name: 'asthma', description: 'A bronchial disease that is characterized by chronic inflammation and narrowing of the airways, which is caused by a combination of environmental and genetic factors resulting in recurring periods of wheezing (a whistling sound while breathing), chest tightness, shortness of breath, mucus production and coughing. The symptoms appear due to a variety of triggers such as allergens, irritants, respiratory infections, weather changes, exercise, stress, reflux disease, medications, foods and emotional anxiety.', icd10: ['J45'], snomedCodes: ['31387002'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0004981', mondoId: 'MONDO:0004981', name: 'atrial fibrillation', description: 'A disorder characterized by an electrocardiographic finding of a supraventricular arrhythmia characterized by the replacement of consistent P waves by rapid oscillations or fibrillatory waves that vary in size, shape and timing and are accompanied by an irregular ventricular response. (CDISC)', icd10: [], snomedCodes: ['49436004'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0004992', mondoId: 'MONDO:0004992', name: 'cancer', description: 'A tumor composed of atypical neoplastic, often pleomorphic cells that invade other tissues. Malignant neoplasms often metastasize to distant anatomic sites and may recur after excision. The most common malignant neoplasms are carcinomas (adenocarcinomas or squamous cell carcinomas), Hodgkin and non-Hodgkin lymphomas, leukemias, melanomas, and sarcomas.', icd10: [], snomedCodes: ['363346000'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0004995', mondoId: 'MONDO:0004995', name: 'cardiovascular disorder', description: 'A disease involving the cardiovascular system.', icd10: [], snomedCodes: ['49601007'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005002', mondoId: 'MONDO:0005002', name: 'chronic obstructive pulmonary disease', description: 'A chronic and progressive lung disorder characterized by the loss of elasticity of the bronchial tree and the air sacs, destruction of the air sacs wall, thickening of the bronchial wall, and mucous accumulation in the bronchial tree. The pathologic changes result in the disruption of the air flow in the bronchial airways. Signs and symptoms include shortness of breath, wheezing, productive cough, and chest tightness. The two main types of chronic obstructive pulmonary disease are chronic obstructive bronchitis and emphysema.', icd10: ['J44'], snomedCodes: ['13645005'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005015', mondoId: 'MONDO:0005015', name: 'diabetes mellitus', description: 'A metabolic disorder characterized by abnormally high blood sugar levels due to diminished production of insulin or insulin resistance/desensitization.', icd10: [], snomedCodes: ['73211009'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005020', mondoId: 'MONDO:0005020', name: 'intestinal disorder', description: 'A non-neoplastic or neoplastic disorder that affects the small or large intestine.', icd10: [], snomedCodes: ['85919009'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005039', mondoId: 'MONDO:0005039', name: 'reproductive system disorder', description: 'A disease involving the reproductive system.', icd10: [], snomedCodes: ['362968007'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005044', mondoId: 'MONDO:0005044', name: 'hypertensive disorder', description: 'Persistently high systemic arterial blood pressure. Based on multiple readings (blood pressure determination), hypertension is currently defined as when systolic pressure is consistently greater than 140 mm Hg or when diastolic pressure is consistently 90 mm Hg or more.', icd10: ['I15'], snomedCodes: ['38341003'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005046', mondoId: 'MONDO:0005046', name: 'immune system disorder', description: 'A disorder resulting from an abnormality in the immune system.', icd10: [], snomedCodes: ['414029004'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005053', mondoId: 'MONDO:0005053', name: 'ischemic disease', description: 'Lack of blood supply to an area of the body, resulting in impairment of tissue oxygenation.', icd10: [], snomedCodes: ['52674009'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005066', mondoId: 'MONDO:0005066', name: 'metabolic disease', description: 'A congenital disorder (due to inherited enzyme abnormality) or acquired (due to failure of a metabolically important organ) disorder resulting from an abnormal metabolic process.', icd10: [], snomedCodes: ['75934005'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005070', mondoId: 'MONDO:0005070', name: 'neoplasm', description: 'A benign or malignant tissue growth resulting from uncontrolled cell proliferation. Benign neoplastic cells resemble normal cells without exhibiting significant cytologic atypia, while malignant cells exhibit overt signs such as dysplastic features, atypical mitotic figures, necrosis, nuclear pleomorphism, and anaplasia. Representative examples of benign neoplasms include papillomas, cystadenomas, and lipomas; malignant neoplasms include carcinomas, sarcomas, lymphomas, and leukemias.', icd10: [], snomedCodes: ['55342001'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005071', mondoId: 'MONDO:0005071', name: 'nervous system disorder', description: 'A non-neoplastic or neoplastic disorder that affects the brain, spinal cord, or peripheral nerves.', icd10: [], snomedCodes: ['118940003'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005084', mondoId: 'MONDO:0005084', name: 'mental disorder', description: 'A disease that has its basis in the disruption of mental process.', icd10: [], snomedCodes: ['74732009'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005087', mondoId: 'MONDO:0005087', name: 'respiratory system disorder', description: 'A non-neoplastic or neoplastic disorder that affects the respiratory system. Representative examples include pneumonia, chronic obstructive pulmonary disease, pulmonary failure, lung adenoma, lung carcinoma, and tracheal carcinoma.', icd10: [], snomedCodes: ['50043002'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005113', mondoId: 'MONDO:0005113', name: 'bacterial infectious disease', description: 'An acute infectious disorder that is caused by gram positive or gram negative bacteria; representative examples include pneumococcal, streptococcal, salmonella, and meningeal infections.', icd10: [], snomedCodes: ['87628006'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005137', mondoId: 'MONDO:0005137', name: 'nutritional disorder', description: 'Any condition related to a disturbance between proper intake and utilization of nourishment.', icd10: [], snomedCodes: ['2492009'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005148', mondoId: 'MONDO:0005148', name: 'type 2 diabetes mellitus', description: 'A type of diabetes mellitus that is characterized by insulin resistance or desensitization and increased blood glucose levels. This is a chronic disease that can develop gradually over the life of a patient and can be linked to both environmental factors and heredity.', icd10: ['E11'], snomedCodes: ['44054006'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005151', mondoId: 'MONDO:0005151', name: 'endocrine system disorder', description: 'A disease involving the endocrine system.', icd10: [], snomedCodes: ['362969004'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005172', mondoId: 'MONDO:0005172', name: 'skeletal system disorder', description: 'A disease involving the skeletal system.', icd10: [], snomedCodes: ['88230002'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005178', mondoId: 'MONDO:0005178', name: 'osteoarthritis', description: 'A noninflammatory degenerative joint disease occurring chiefly in older persons, characterized by degeneration of the articular cartilage, hypertrophy of bone at the margins and changes in the synovial membrane. It is accompanied by pain and stiffness, particularly after prolonged activity.', icd10: [], snomedCodes: ['396275006'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005240', mondoId: 'MONDO:0005240', name: 'kidney disorder', description: 'A disease involving the kidney.', icd10: [], snomedCodes: ['90708001'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005247', mondoId: 'MONDO:0005247', name: 'bacterial urinary tract infection', description: 'A bacterial infectious process affecting any part of the urinary tract, most commonly the bladder and the urethra. Symptoms include urinary urgency and frequency, burning sensation during urination, lower abdominal discomfort, and cloudy urine.', icd10: [], snomedCodes: ['68566005'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005252', mondoId: 'MONDO:0005252', name: 'heart failure', description: 'Inability of the heart to pump blood at an adequate rate to meet tissue metabolic requirements. Clinical symptoms of heart failure include: unusual dyspnea on light exertion, recurrent dyspnea occurring in the supine position, fluid retention or rales, jugular venous distension, pulmonary edema on physical exam, or pulmonary edema on chest x-ray presumed to be cardiac dysfunction.', icd10: ['I50'], snomedCodes: ['84114007'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005265', mondoId: 'MONDO:0005265', name: 'inflammatory bowel disease', description: 'A spectrum of small and large bowel inflammatory diseases of unknown etiology. It includes Crohn\'s disease, ulcerative colitis, and colitis of indeterminate type.', icd10: [], snomedCodes: ['24526004'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005267', mondoId: 'MONDO:0005267', name: 'heart disorder', description: 'A disease involving the heart and/or pericardium.', icd10: [], snomedCodes: ['56265001'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005275', mondoId: 'MONDO:0005275', name: 'lung disorder', description: 'A disease involving the lung.', icd10: [], snomedCodes: ['19829001'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005296', mondoId: 'MONDO:0005296', name: 'sleep apnea syndrome', description: 'A disorder characterized by multiple cessations of respirations during sleep that induce partial arousals and interfere with the maintenance of sleep.', icd10: ['G47.3'], snomedCodes: ['111489007', '73430006'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005300', mondoId: 'MONDO:0005300', name: 'chronic kidney disease', description: 'Impairment of the renal function secondary to chronic kidney damage persisting for three or more months.', icd10: ['N18.9'], snomedCodes: ['709044004'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005335', mondoId: 'MONDO:0005335', name: 'colorectal neoplasm', description: 'A benign or malignant neoplasm that affects the colon or rectum. Representative examples of benign neoplasms include lipoma and leiomyoma. Representative examples of malignant neoplasms include carcinoma, lymphoma, and sarcoma. Colorectal adenomas always exhibit epithelial dysplasia and are considered premalignant neoplasms.', icd10: [], snomedCodes: [], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005371', mondoId: 'MONDO:0005371', name: 'mood disorder', description: 'A cognitive disorder a disturbance in which the person\'s mood is hypothesized to be the main underlying feature.', icd10: [], snomedCodes: ['46206005'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005381', mondoId: 'MONDO:0005381', name: 'bone disorder', description: 'Diseases of bones.', icd10: [], snomedCodes: ['76069003'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005385', mondoId: 'MONDO:0005385', name: 'vascular disorder', description: 'A general term used to describe any disease affecting blood vessels]. It includes vascular abnormalities caused by degenerative, metabolic and inflammatory conditions, embolic diseases, coagulative disorders, and functional disorders such as posteri or reversible encephalopathy syndrome.', icd10: [], snomedCodes: ['27550009'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005401', mondoId: 'MONDO:0005401', name: 'colonic neoplasm', description: 'A benign or malignant neoplasm that affects the colon. Representative examples of benign neoplasms include lipoma and leiomyoma. Representative examples of malignant neoplasms include carcinoma, lymphoma, and sarcoma. Colonic adenomas always exhibit epithelial dysplasia and are considered premalignant neoplasms.', icd10: [], snomedCodes: [], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005420', mondoId: 'MONDO:0005420', name: 'hypothyroidism', description: 'Abnormally low levels of thyroid hormone.', icd10: [], snomedCodes: ['40930008'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005550', mondoId: 'MONDO:0005550', name: 'infectious disease', description: 'A disorder directly resulting from the presence and activity of a microbial, viral, or parasitic agent in humans. It can be transmitted by direct or indirect contact.', icd10: [], snomedCodes: ['40733004'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005554', mondoId: 'MONDO:0005554', name: 'rheumatic disorder', description: 'Inflammatory and degenerative diseases of connective tissue structures, such as arthritis.', icd10: [], snomedCodes: ['396332003'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005560', mondoId: 'MONDO:0005560', name: 'brain disorder', description: 'A disease affecting the brain or part of the brain.', icd10: [], snomedCodes: ['81308009'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005570', mondoId: 'MONDO:0005570', name: 'hematologic disorder', description: 'A disease involving the hematopoietic system.', icd10: [], snomedCodes: ['414022008'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005575', mondoId: 'MONDO:0005575', name: 'colorectal cancer', description: 'A primary or metastatic malignant neoplasm that affects the colon or rectum. Representative examples include carcinoma, lymphoma, and sarcoma.', icd10: [], snomedCodes: ['363510005'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005578', mondoId: 'MONDO:0005578', name: 'arthritic joint disease', description: 'An inflammatory process affecting a joint. Causes include infection, autoimmune processes, degenerative processes, and trauma. Signs and symptoms may include swelling around the affected joint and pain.', icd10: [], snomedCodes: ['3723001'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005618', mondoId: 'MONDO:0005618', name: 'anxiety disorder', description: 'A category of psychiatric disorders which are characterized by anxious feelings or fear often accompanied by physical symptoms associated with anxiety.', icd10: [], snomedCodes: ['197480006'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005814', mondoId: 'MONDO:0005814', name: 'intestinal cancer', description: 'A malignant neoplasm involving the intestine', icd10: [], snomedCodes: ['363508008'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005836', mondoId: 'MONDO:0005836', name: 'male reproductive organ cancer', description: 'A primary or metastatic malignant neoplasm involving the male reproductive system. Representative examples include prostate carcinoma, penile carcinoma, testicular seminoma, and testicular embryonal carcinoma.', icd10: [], snomedCodes: ['363515000'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0005961', mondoId: 'MONDO:0005961', name: 'sinusitis', description: 'An acute or chronic inflammatory process affecting the mucous membranes of any sinus cavity.', icd10: [], snomedCodes: ['36971009'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0006031', mondoId: 'MONDO:0006031', name: 'chronic rhinosinusitis', description: 'Chronic form of sinusitis.', icd10: [], snomedCodes: ['40055000'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0006054', mondoId: 'MONDO:0006054', name: 'reproductive system neoplasm', description: 'A benign or malignant, primary or metastatic neoplasm affecting the male and female reproductive system.', icd10: [], snomedCodes: [], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0006816', mondoId: 'MONDO:0006816', name: 'arthropathy', description: 'Any disorder of the joints.', icd10: [], snomedCodes: ['399269003'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0006873', mondoId: 'MONDO:0006873', name: 'nutritional deficiency disease', description: 'A condition produced by dietary or metabolic deficiency. The term includes all diseases caused by an insufficient supply of essential nutrients, i.e., protein (or amino acids), vitamins, and minerals. It also includes an inadequacy of calories. (From Dorland, 27th ed; Stedman, 25th ed)', icd10: [], snomedCodes: ['363246002', '70241007'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0007179', mondoId: 'MONDO:0007179', name: 'autoimmune disease', description: 'A disorder resulting from loss of function or tissue destruction of an organ or multiple organs, arising from humoral or cellular immune responses of the individual to their own tissue constituents. It may be systemic (e.g., systemic lupus erythematosus), or organ specific, (e.g., thyroiditis).', icd10: ['M30'], snomedCodes: ['85828009'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0007254', mondoId: 'MONDO:0007254', name: 'breast cancer', description: 'A primary or metastatic malignant neoplasm involving the breast. The vast majority of cases are carcinomas arising from the breast parenchyma or the nipple. Malignant breast neoplasms occur more frequently in females than in males.', icd10: ['C50'], snomedCodes: ['254837009'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0007263', mondoId: 'MONDO:0007263', name: 'cardiac rhythm disease', description: 'Any variation from the normal rate or rhythm (which may include the origin of the impulse and/or its subsequent propagation) in the heart.', icd10: [], snomedCodes: ['698247007'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0008315', mondoId: 'MONDO:0008315', name: 'prostate cancer', description: 'A primary or metastatic malignant tumor involving the prostate gland. The vast majority are carcinomas.', icd10: ['C61'], snomedCodes: ['399068003'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0008383', mondoId: 'MONDO:0008383', name: 'rheumatoid arthritis', description: 'A chronic, systemic autoimmune disorder characterized by inflammation in the synovial membranes and articular surfaces. It manifests primarily as a symmetric, erosive polyarthritis that spares the axial skeleton and is typically associated with the presence in the serum of rheumatoid factor.', icd10: ['M05', 'M06'], snomedCodes: ['69896004'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0009960', mondoId: 'MONDO:0009960', name: 'inflammatory bowel disease 1', description: 'Any inflammatory bowel disease in which the cause of the disease is a mutation in the NOD2 gene.', icd10: ['K50', 'K51', 'K52', 'K52.8', 'K52.9'], snomedCodes: ['34000006'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0011122', mondoId: 'MONDO:0011122', name: 'obesity disorder', description: 'A disorder involving an excessive amount of body fat.', icd10: [], snomedCodes: ['414916001'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0021063', mondoId: 'MONDO:0021063', name: 'malignant colon neoplasm', description: 'A primary or metastatic malignant neoplasm that affects the colon. Representative examples include carcinoma, lymphoma, and sarcoma.', icd10: ['C18'], snomedCodes: ['363406005'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0021100', mondoId: 'MONDO:0021100', name: 'breast neoplasm', description: 'A benign or malignant neoplasm of the breast parenchyma. It can originate from the ducts, lobules or the breast adipose tissue. Breast neoplasms are much more common in females than males.', icd10: [], snomedCodes: ['126926005'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0021118', mondoId: 'MONDO:0021118', name: 'intestinal neoplasm', description: 'A benign or malignant neoplasm involving the small or large intestine.', icd10: [], snomedCodes: ['126769007'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0021166', mondoId: 'MONDO:0021166', name: 'inflammatory disease', description: 'A disease involving a pathogenic inflammatory response in the anatomical structure.', icd10: [], snomedCodes: ['128139000'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0021187', mondoId: 'MONDO:0021187', name: 'hyperlipidemia', description: '', icd10: ['E78.5'], snomedCodes: ['55822004'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0021223', mondoId: 'MONDO:0021223', name: 'digestive system neoplasm', description: 'A neoplasm (disease) that involves the digestive system.', icd10: [], snomedCodes: [], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0021259', mondoId: 'MONDO:0021259', name: 'prostate neoplasm', description: 'A neoplasm (disease) that involves the prostate gland.', icd10: [], snomedCodes: [], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0021350', mondoId: 'MONDO:0021350', name: 'neoplasm of thorax', description: 'A neoplasm (disease) that involves the thoracic segment of trunk.', icd10: [], snomedCodes: ['255058005'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0023370', mondoId: 'MONDO:0023370', name: 'neoplastic disease or syndrome', description: 'Either an isolated neoplasm or a syndrome with neoplasm as a major feature.', icd10: [], snomedCodes: [], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0024582', mondoId: 'MONDO:0024582', name: 'male reproductive system neoplasm', description: 'A benign, borderline, or malignant neoplasm that affects the male reproductive system. Representative examples include benign prostate phyllodes tumor, benign testicular Sertoli cell tumor, prostatic intraepithelial neoplasia, prostate carcinoma, testicular seminoma, and testicular embryonal carcinoma.', icd10: [], snomedCodes: ['126895004'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0024623', mondoId: 'MONDO:0024623', name: 'otorhinolaryngologic disease', description: 'Pathological processes of the ear, the nose, and the throat, also known as the ENT diseases.', icd10: [], snomedCodes: ['232208008'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0024634', mondoId: 'MONDO:0024634', name: 'large intestine disorder', description: 'A disease that involves the large intestine.', icd10: [], snomedCodes: ['119523007'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0024643', mondoId: 'MONDO:0024643', name: 'myocardial disorder', description: 'A disorder that affects the muscle tissue of the heart. Representative examples include myocardial infarction, myocarditis, and cardiomyopathy.', icd10: [], snomedCodes: ['57809008'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0024644', mondoId: 'MONDO:0024644', name: 'myocardial ischemia', description: 'A disorder of cardiac function caused by insufficient blood flow to the muscle tissue of the heart. The decreased blood flow may be due to narrowing of the coronary arteries (coronary artery disease), to obstruction by a thrombus (coronary thrombosis), or less commonly, to diffuse narrowing of arterioles and other small vessels within the heart. Severe interruption of the blood supply to the myocardial tissue may result in necrosis of cardiac muscle (myocardial infarction).', icd10: [], snomedCodes: ['414545008'], hubMatch: true, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0024654', mondoId: 'MONDO:0024654', name: 'skull disorder', description: 'A non-neoplastic or neoplastic disorder that affects structures of the skull.', icd10: [], snomedCodes: ['118945008'], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0045024', mondoId: 'MONDO:0045024', name: 'cancer or benign tumor', description: 'Any disorder that features disrupted cell proliferation. Includes hyperplasia, neoplastic syndrome and isolated neoplasm diseases as well as precancerous conditions.', icd10: [], snomedCodes: [], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0100081', mondoId: 'MONDO:0100081', name: 'sleep disorder', description: 'A change from the patient\'s baseline sleeping pattern, in the hours slept and/or an alteration/dysfunction in the stages of sleep.', icd10: [], snomedCodes: [], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0100338', mondoId: 'MONDO:0100338', name: 'urinary tract infection', description: '', icd10: [], snomedCodes: [], hubMatch: false, nedrexRelease: '2.2.13'},
  {nedrexId: 'mondo.0700096', mondoId: 'MONDO:0700096', name: 'human disease', description: '', icd10: [], snomedCodes: [], hubMatch: false, nedrexRelease: '2.2.13'}
] AS row
MERGE (d:NeDRexDisorder {nedrexId: row.nedrexId})
ON CREATE SET d += row
ON MATCH SET d += row;

