@startuml data-flow
!include <archimate/Archimate>
title From synthetic patients to analytics (ArchiMate 3.2, application process view)\nthe processes, the data each one produces, and the components that run them
skinparam defaultFontName Helvetica
skinparam shadowing false
skinparam nodesep 18
skinparam ranksep 44
skinparam rectangle {
  BorderColor #64748B
  FontStyle bold
}

rectangle "Processes" as PR #B5FFFF {
  Application_Process(p_gen, "Generate synthetic\npatients")
  Application_Process(p_load, "Load the FHIR bundles\ninto the graph")
  Application_Process(p_map, "Map FHIR to OMOP\nMAPPED_TO per resource")
  Application_Process(p_code, "Copy the codings\nCODED_BY to SNOMED, LOINC, RxNorm")
  Application_Process(p_query, "Run cohort queries")
  Application_Process(p_render, "Render dashboards\nand charts")
}
rectangle "Data" as DA #D6FFFF {
  Application_DataObject(d_bundles, "FHIR R4 bundles\n127 synthetic patients")
  Application_DataObject(d_fhir, "FHIR nodes and\nrelationships, layer 3")
  Application_DataObject(d_omop, "OMOP CDM nodes,\nlayer 4")
  Application_DataObject(d_codes, "Ontology nodes,\nlayer 5")
  Application_DataObject(d_cohorts, "Cohort statistics")
}
rectangle "Components" as CO #B5FFFF {
  Application_Component(c_synthea, "Synthea")
  Application_Component(c_loader, "load_fhir_neo4j.py")
  Application_Component(c_cypher, "fhir-to-omop-transform.cypher")
  Application_Component(c_proxy, "neo4j-proxy\n/omop/cohort")
  Application_Component(c_ui, "Hub UI\n/analytics")
}
rectangle "Platform" as PL #C9E7B7 {
  Technology_Node(c_neo4j, "Neo4j 5\nthe knowledge graph, layers 1 to 5")
}

Rel_Triggering_Right(p_gen, p_load)
Rel_Triggering_Right(p_load, p_map)
Rel_Triggering_Right(p_map, p_code)
Rel_Triggering_Right(p_code, p_query)
Rel_Triggering_Right(p_query, p_render)

Rel_Access(p_gen, d_bundles, "writes")
Rel_Access(p_load, d_fhir, "writes")
Rel_Access(p_map, d_omop, "writes")
Rel_Access(p_code, d_codes, "writes")
Rel_Access(p_query, d_cohorts, "writes")

Rel_Assignment_Up(c_synthea, p_gen)
Rel_Assignment_Up(c_loader, p_load)
Rel_Assignment_Up(c_cypher, p_map)
Rel_Assignment_Up(c_cypher, p_code)
Rel_Assignment_Up(c_proxy, p_query)
Rel_Assignment_Up(c_ui, p_render)
Rel_Serving_Up(c_neo4j, c_loader)
Rel_Serving_Up(c_neo4j, c_cypher)
Rel_Serving_Up(c_neo4j, c_proxy)

d_bundles -[hidden]right- d_fhir
d_fhir -[hidden]right- d_omop
d_omop -[hidden]right- d_codes
d_codes -[hidden]right- d_cohorts
p_gen -[hidden]down- d_bundles
d_bundles -[hidden]down- c_synthea
c_synthea -[hidden]right- c_loader
c_loader -[hidden]right- c_cypher
c_cypher -[hidden]right- c_proxy
c_proxy -[hidden]right- c_ui

legend bottom left
|= Relationship |= Meaning |
| solid line, filled head | triggering: one process starts the next |
| dotted, no head | access: the process writes the object |
| line with a dot | assignment: the component performs the process |
| solid line, open arrow | serving: the graph serves the component |
endlegend
@enduml
