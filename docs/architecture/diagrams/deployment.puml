@startuml deployment
!include <archimate/Archimate>
title Deployment topology (ArchiMate 3.2, technology view)\nthe JAD stack on EDC 1.0 as Docker Compose runs it, with siglet as the data plane and no CFM (ADR-078)
skinparam defaultFontName Helvetica
skinparam shadowing false
skinparam nodesep 14
skinparam ranksep 46
skinparam rectangle {
  BorderColor #64748B
  FontStyle bold
}

rectangle "Edge and clients" as EDGE #C9E7B7 {
  Technology_SystemSoftware(tfk, "Traefik\nAPI gateway, :80 and :8090")
  Technology_Node(ghp, "GitHub Pages\nstatic demo site")
}
rectangle "Application" as APP #D9F0CB {
  Technology_SystemSoftware(ui, "Next.js UI\ngraph explorer, :3000 and :3003")
  Technology_SystemSoftware(proxy, "neo4j-proxy\nExpress bridge, pulls at /dataspace/data, :9090")
  Technology_SystemSoftware(neo4j, "Neo4j 5\nknowledge graph, :7474 and :7687")
}
rectangle "EDC 1.0" as EDC #D9F0CB {
  Technology_SystemSoftware(cp, "Control plane\nDSP 2025-1 and management API v5, :11003")
  Technology_SystemSoftware(sig, "siglet\ndata plane: signalling and pull tokens")
}
rectangle "Identity" as IDM #D9F0CB {
  Technology_SystemSoftware(ih, "Identity Hub\nDCP, credential store, :11005")
  Technology_SystemSoftware(is, "Issuer Service\ncredential issuance, :10013")
  Technology_SystemSoftware(sga, "Simpl GA issuer\nSimpl Governance Authority, :10023")
}
rectangle "Infrastructure" as INFRA #C9E7B7 {
  Technology_SystemSoftware(kc, "Keycloak\nOIDC SSO, :8080 and :9000")
  Technology_Node(pg, "PostgreSQL 17\nruntime store, :5432")
  Technology_SystemSoftware(vault, "HashiCorp Vault\nfile storage, :8200")
  Technology_SystemSoftware(vu, "vault-unseal and vault-bootstrap\ninit sidecars")
  Technology_SystemSoftware(nats, "NATS JetStream\nevent mesh, :4222 and :8222")
}
rectangle "Compose profiles, not started by default" as PROF #E5E7EB {
  Technology_SystemSoftware(e018, "edc018\nDCore data planes, CFM managers, agents and shim, jad-seed")
  Technology_SystemSoftware(trust, "trust-check\nrogue-issuer, :10033")
  Technology_SystemSoftware(fed, "federated\nNeo4j SPE2, :7475 and :7688")
}

' ── Routing and the static export ────────────────────────────────────────────
Rel_Flow(tfk, cp, "routes")
Rel_Flow(tfk, proxy, " ")
Rel_Flow(tfk, ih, " ")
Rel_Flow(tfk, is, " ")
Rel_Flow_Up(ui, ghp, "next export")

' ── Application depends on ───────────────────────────────────────────────────
Rel_Serving_Right(proxy, ui)
Rel_Serving_Up(cp, ui)
Rel_Serving_Up(cp, proxy)
Rel_Serving_Right(neo4j, proxy)
Rel_Serving_Up(sig, ui, "pull token")
Rel_Serving_Up(sig, proxy, "token keys")

' ── EDC 1.0 depends on ───────────────────────────────────────────────────────
Rel_Serving_Up(pg, cp)
Rel_Serving_Up(vault, cp)
Rel_Serving_Up(nats, cp)
Rel_Serving_Up(kc, cp)
Rel_Serving_Left(sig, cp)
Rel_Serving_Up(vault, sig)

' ── Identity depends on ──────────────────────────────────────────────────────
Rel_Serving_Up(pg, ih)
Rel_Serving_Up(vault, ih)
Rel_Serving_Up(kc, ih)
Rel_Serving_Up(pg, is)
Rel_Serving_Up(vault, is)
Rel_Serving_Up(kc, is)
Rel_Serving_Up(pg, sga)
Rel_Serving_Up(vault, sga)
Rel_Serving_Up(kc, sga)

' ── Infrastructure ───────────────────────────────────────────────────────────
Rel_Serving_Left(pg, kc)
Rel_Serving_Left(kc, vu)
Rel_Serving_Left(vu, vault)

' ── Rows ────────────────────────────────────────────────────────────────────
tfk -[hidden]right- ghp
ui -[hidden]right- proxy
proxy -[hidden]right- neo4j
cp -[hidden]right- sig
ih -[hidden]right- is
is -[hidden]right- sga
nats -[hidden]right- vault
vault -[hidden]right- vu
vu -[hidden]right- kc
kc -[hidden]right- pg
EDC -[hidden]right- IDM
INFRA -[hidden]down- PROF
e018 -[hidden]right- trust
trust -[hidden]right- fed

legend bottom left
|= Relationship |= Meaning |
| solid line, open arrow | serving: the lower service is what the upper one depends on at run time |
| dashed arrow | flow: traffic routed, the export published |
| grey band | compose profiles: started only with --profile <name> |
endlegend
@enduml
