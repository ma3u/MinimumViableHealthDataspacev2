# CFM 0.0.7 IdentityHub agent (ADR-085, #973). Keys as in eclipse-cfm/core-platform-distribution v0.0.39
# templates/cfm/cfm-agents-configs.yaml, with our hosts, and Keycloak behind jad/cfm/token-exchange.mjs for jwtlet.
uri: nats://cfm7-nats:4222
# NATS token, local dev only (cfm7-nats --auth in docker-compose.jad.yml)
nats.auth.method: token
nats.auth.token: cfm-nats-local-dev
bucket: cfm-bucket
stream: cfm-stream
httpport: 8080
postgres: true
dsn: postgres://cfm:cfm@postgres:5432/cfm_v007?sslmode=disable
vault.url: http://vault:8200
identityhub.url: http://identityhub:7081/api/identity
identityhub.cs.url: http://identityhub:7082/api/credentials/v1/participants/%s
controlplane.protocol.url: http://controlplane:8082/api/dsp/%s/http-dsp-profile-2025-1
controlplane.dataservice.url: http://controlplane:8082/api/dsp/%s/.well-known/dspace-version
tokenexchange.url: http://cfm7-token-exchange:8080
tokenexchange.audience: cfm-agents
tokenexchange.tokenFilePath: /var/run/secrets/cfm/token
