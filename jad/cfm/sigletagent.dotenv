# CFM siglet agent (the fork's v0.0.7-mvhd.3, ADR-085, #973). Keys as in eclipse-cfm/core-platform-distribution v0.0.39
# templates/cfm/cfm-agents-configs.yaml, with our hosts.
uri: nats://cfm7-nats:4222
# NATS token, local dev only (cfm7-nats --auth in docker-compose.jad.yml)
nats.auth.method: token
nats.auth.token: cfm-nats-local-dev
bucket: cfm-bucket
stream: cfm-stream
httpport: 8080
postgres: true
dsn: postgres://cfm:cfm@postgres:5432/cfm_v007?sslmode=disable
siglet.management.url: http://siglet:8083
siglet.signaling.url: http://siglet:8081
controlplane.url: http://controlplane:8081/api/mgmt
# Token exchange at Keycloak (fork fix a): client credentials instead of a token
# file, access tokens as subject tokens. The secret is local dev only, as
# edc-v-admin-secret; scripts/seed-cfm.sh creates the client with it.
tokenexchange.url: http://keycloak:8080/realms/edcv/protocol/openid-connect
tokenexchange.audience: cfm-agents
tokenexchange.subjectTokenType: urn:ietf:params:oauth:token-type:access_token
tokenexchange.clientId: cfm-agents
tokenexchange.clientSecret: cfm-agents-local-dev
tokenexchange.issuer: http://localhost:8080/realms/edcv
tokenexchange.jwksUri: http://keycloak:8080/realms/edcv/protocol/openid-connect/certs
tokenexchange.scope: signaling
