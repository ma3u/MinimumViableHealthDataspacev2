{
  "@context": [
    "http://www.w3.org/ns/odrl.jsonld",
    {
      "ehds": "https://w3id.org/ehds/",
      "edc": "https://w3id.org/edc/v0.0.1/ns/"
    }
  ],
  "@type": "Set",
  "@id": "mvhd-bonus-programme",
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "ehds:purpose",
          "operator": "eq",
          "rightOperand": "EHDS Art. 7(3) - primary use the person directs: the bonus payout of a programme the member joined"
        },
        {
          "leftOperand": "ehds:attestedPurpose",
          "operator": "eq",
          "rightOperand": "bonus-payout"
        },
        {
          "leftOperand": "ehds:legalBasis",
          "operator": "eq",
          "rightOperand": "GDPR Art. 9(2)(a), the member's explicit consent to the programme"
        }
      ],
      "duty": [
        {
          "action": "delete",
          "constraint": [
            {
              "leftOperand": "event",
              "operator": "eq",
              "rightOperand": "after the bonus payout"
            }
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "ehds:insuranceDecision"
    },
    {
      "action": "ehds:profile"
    },
    {
      "action": "ehds:advertise"
    },
    {
      "action": "ehds:detrimentalDecision"
    }
  ]
}
