meta {
  name: 24 I ask the hub to send my answer
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/api/patient/programmes/transfer
  body: json
  auth: inherit
}

headers {
  Cookie: {{cookieName}}={{sessionTokenPatient}}
}

body:json {
  {
    "programmeId": "{{programmeId}}",
    "year": 2027
  }
}

tests {
  if (!bru.getVar("programmeId")) {
    test("SKIPPED: no bonus program on this stack to send to (#934)", function () {});
  } else {
    test("accepted: 202, the year and no answer until the hub evaluates it", function () {
      expect(res.getStatus()).to.equal(202);
      const t = res.getBody().transfer;
      expect(t.year).to.equal(2027);
      expect(t.goalMet).to.equal(null);
      expect(t.status).to.equal("awaiting-evaluation");
    });
  }
}

docs {
  ADR-080, decision 4, second path: the person tells the hub to send the program the year's answer. It goes out only under an open consent; the answer itself is computed in step 6.
}
