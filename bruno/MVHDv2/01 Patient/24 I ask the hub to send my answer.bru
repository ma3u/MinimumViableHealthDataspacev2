meta {
  name: 24 I ask the hub to send my answer
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/api/patient/programmes/transfer
  body: json
  auth: inherit
}

headers {
  Cookie: {{cookieName}}={{sessionTokenPatient}}
}

body:json {
  {
    "programmeId": "{{programmeId}}",
    "year": 2025
  }
}

tests {
  if (!bru.getVar("programmeId")) {
    test("SKIPPED: no bonus program on this stack to send to (#934)", function () {});
  } else {
    test("accepted: 202, evaluated inside the record: the year and goal met, nothing else", function () {
      expect(res.getStatus()).to.equal(202);
      const t = res.getBody().transfer;
      expect(t.year).to.equal(2025);
      expect(t.goalMet).to.be.a("boolean");
      expect(t.status).to.equal("evaluated");
      expect(Object.keys(t).sort()).to.eql(
        ["goalMet", "programmeId", "requestedAt", "status", "transferId", "year"]);
    });
  }
}

docs {
  ADR-080, decision 4, second path: the person tells the hub to send the program the year's answer. It goes out only under an open consent, for the ended year the rule covers; the hub works out goal met inside the record and records only that (step 6, ADR-087).
}
