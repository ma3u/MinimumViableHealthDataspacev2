meta {
  name: 14 An application with no items (400)
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/compliance/applications
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Cookie: {{cookieName}}={{sessionTokenResearcher}}
}

body:json {
  {}
}

assert {
  res.status: eq 400
  res.body.error: contains datasetId
  res.body.purposes: isArray
}
