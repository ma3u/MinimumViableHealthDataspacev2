meta {
  name: 10 Patient cannot touch the Art. 68 clock (403)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/compliance/applications/clock
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Cookie: {{cookieName}}={{sessionTokenPatient}}
}

body:json {
  {
    "applicationId": "app-whatever",
    "action": "EXTEND"
  }
}

assert {
  res.status: eq 403
}
