meta {
  name: 38 No session, the secure processing environments (401)
  type: http
  seq: 38
}

get {
  url: {{baseUrl}}/api/admin/spe
  body: none
  auth: inherit
}

headers {
  Cookie: {{cookieName}}=not-a-session
}

tests {
  // ADR-044 and ADR-068: only the operator and the access body see where the
  // SPEs run and which permit's key was released (#774).
  test("an anonymous caller is refused", function () {
    expect(res.getStatus()).to.equal(401);
  });
  test("the refusal says so in the body", function () {
    expect(res.getBody(), "an { error } body").to.have.property("error");
  });
}
