meta {
  name: 05 Activity report (Art. 59)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/activity-report
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.article: isDefined
  res.body.accessBodies: isArray
  res.body.items: isDefined
  res.body.article: contains 2025/327
}

tests {
  test("accessBodies is not empty", function () {
    expect(res.getBody().accessBodies).to.not.be.empty;
  });
}
