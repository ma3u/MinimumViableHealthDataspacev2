meta {
  name: 02 Public information (Art. 58)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/information
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.article: isDefined
  res.body.bodies: isArray
  res.body.access: isArray
  res.body.optOut: isDefined
  res.body.fees: isDefined
  res.body.article: contains 2025/327
}

tests {
  test("bodies is not empty", function () {
    expect(res.getBody().bodies).to.not.be.empty;
  });
  test("access is not empty", function () {
    expect(res.getBody().access).to.not.be.empty;
  });
}

docs {
  Access bodies, access conditions, results, the Art. 71(2) opt-out, retention and fees.
}
