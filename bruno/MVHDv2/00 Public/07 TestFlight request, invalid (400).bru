meta {
  name: 07 TestFlight request, invalid (400)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/testflight-request
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Cookie: {{cookieName}}=not-a-session
}

body:json {
  {
    "name": "Bruno",
    "appleId": "not-an-email"
  }
}

tests {
  // ADR-048: the start page's TestFlight form answers without a session.
  // The Apple ID is malformed on purpose, so the run never sends a mail and
  // gets the same 400 on every stack, with or without mail configured.
  test("an invalid request is refused without a session, not with 401", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("the refusal says why in the body", function () {
    expect(res.getBody(), "an { error } body").to.have.property("error");
  });
}
