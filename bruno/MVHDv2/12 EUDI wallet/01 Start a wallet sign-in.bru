meta {
  name: 01 Start a wallet sign-in
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/eudi/start
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Cookie: {{cookieName}}=not-a-session
}

body:json {
  {}
}

assert {
  res.status: eq 200
  res.body: isJson
}
