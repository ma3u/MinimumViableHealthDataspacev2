headers {
  Accept: application/json
  Cookie: {{cookieName}}={{sessionToken}}
}

auth {
  mode: none
}

script:pre-request {
  // Every request inherits this Cookie header. The session cookies are forged
  // per persona by scripts/run-api-tests.sh (Local: from the UI container's
  // NEXTAUTH_SECRET; Azure-Dev: from the repository secret) and never live in
  // git. Requests that act as another persona override the header; requests
  // that must be unauthenticated send a bogus value.
  const base = bru.getEnvVar("baseUrl") || "";
  const isStatic = base.includes("github.io");
  if (!isStatic && !bru.getEnvVar("sessionToken") && !bru.getVar("sessionToken")) {
    console.warn("[MVHDv2] sessionToken is empty: run scripts/run-api-tests.sh, or forge one with ui/scripts/forge-bruno-session.mjs");
  }
}

tests {
  // A 5xx is never acceptable, whatever the request asserts.
  test("response is not a server error", function () {
    expect(res.getStatus()).to.be.below(500);
  });
}

docs {
  # MVHDv2: the EHDS integration hub's API, request by request

  What a hospital, an access body or a research organisation can rehearse against
  the hub with synthetic data before connecting anything real. Folders 00 to 11 go
  through the UI's API (`/api/*`, NextAuth session cookie); folder 12 speaks to the
  EDC layer directly (Management API, IdentityHub, IssuerService, Keycloak) and
  folder 13 to the Neo4j proxy.

  Every request asserts the status it expects and the shape of the body; a 401,
  403 or 404 is a failure unless the request is there to prove that boundary.

  Run it: `scripts/run-api-tests.sh Local` (compose stack), `Static-mock`
  (GitHub Pages fixtures, GET only), `Azure-Dev` (needs NEXTAUTH_SECRET).
  Full guide in `bruno/MVHDv2/README.md`; tracking issue #348.
}
