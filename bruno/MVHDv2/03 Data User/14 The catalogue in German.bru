meta {
  name: 14 The catalogue in German
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/catalog
  body: none
  auth: inherit
}

headers {
  Cookie: {{cookieName}}={{sessionTokenResearcher}}
}

assert {
  res.status: eq 200
  res.body: isArray
}

tests {
  // #782: the catalogue page shows the description in the language a visitor
  // chooses and falls back to English. The translations come as a map.
  const sets = res.getBody();
  const german = sets.filter((d) => d.translations && d.translations.de);
  test("datasets carry a German title", function () {
    expect(german.length, "datasets with German").to.be.above(0);
    for (const d of german) expect(d.translations.de.title, d.id).to.be.a("string");
  });
  test("English stays the title, whatever else is there", function () {
    for (const d of sets) expect(d.title, d.id).to.be.a("string");
  });
}
