meta {
  name: 20 The transfer is started (DSP)
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/api/transfers?participantId={{dspConsumerCtx}}
  body: none
  auth: inherit
}

headers {
  Cookie: {{cookieName}}={{sessionTokenResearcher}}
}

script:pre-request {
  // Poll rather than wait a fixed time: on 2026-11-05 a 25 s wait found the
  // negotiation at VERIFIED, one step short (#876). Up to 90 s, every 5 s.
  if (bru.getEnvVar("dspLiveFlow") === "true") {
    const axios = require("axios");
    const headers = {
      Cookie: `${bru.getEnvVar("cookieName")}=${bru.getEnvVar("sessionTokenResearcher")}`,
    };
    const url = `${bru.getEnvVar("baseUrl")}/api/transfers?participantId=${bru.getVar("dspConsumerCtx")}`;
    for (let i = 0; i < 18; i++) {
      await new Promise((resolve) => setTimeout(resolve, 5000));
      const rows = (await axios.get(url, { headers, validateStatus: () => true })).data;
      const row = Array.isArray(rows) ? rows.find((r) => r["@id"] === bru.getVar("dspTransferId")) : null;
      if (row && ["STARTED", "COMPLETED", "TERMINATED"].includes(row.state)) break;
    }
  }
}

assert {
  res.status: eq 200
  res.body: isArray
}

tests {
  const row = res.getBody().find((t) => t["@id"] === bru.getVar("dspTransferId")) || {};
  if (bru.getEnvVar("dspLiveFlow") !== "true") {
    test("SKIPPED live check: this environment does not run the DSP flow end to end (#542)", function () {});
  } else {
    // "Connect timed out" here is the control plane failing to reach
    // http://mvhd-siglet:8081: run scripts/azure/17-siglet.sh --check (#876).
    test("STARTED", function () {
      expect(row.state, `transfer ${bru.getVar("dspTransferId")}: ${row.errorDetail || "not listed"}`).to.equal("STARTED");
    });
  }
}
