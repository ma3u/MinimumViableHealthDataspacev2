meta {
  name: 26 A second import asks first (DSP)
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/api/transfers/{{dspTransferId}}/import
  body: json
  auth: inherit
}

headers {
  Cookie: {{cookieName}}={{sessionTokenResearcher}}
}

body:json {
  {
    "participantId": "{{dspConsumerCtx}}",
    "speId": "SPE-1"
  }
}

tests {
  const body = res.getBody() || {};
  if (!bru.getVar("dspImported")) {
    test("SKIPPED: 23 imported nothing on this run, so there is nothing to import twice", function () {});
  } else {
    test("the transfer 23 imported is closed, so it cannot be imported again", function () {
      expect(res.getStatus(), body.error || "").to.equal(409);
      expect(body.state, body.error || "").to.be.oneOf(["TERMINATING", "TERMINATED"]);
    });
  }
}

docs {
  An SPE holds a transfer once (#876). Since #924 the import also terminates the transfer, so the
  access to the provider's data ends with it, and a second import is refused before it reaches the
  SPE: 409 with the transfer's state. A STARTED transfer the SPE already holds still answers 409 with
  that import (`existing`), and My data then asks the user to overwrite it or to cancel.
}
