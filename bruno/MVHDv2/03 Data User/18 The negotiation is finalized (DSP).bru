meta {
  name: 18 The negotiation is finalized (DSP)
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/api/negotiations?participantId={{dspConsumerCtx}}
  body: none
  auth: inherit
}

headers {
  Cookie: {{cookieName}}={{sessionTokenResearcher}}
}

script:pre-request {
  // Poll rather than wait a fixed time: on 2026-11-05 a 25 s wait found the
  // negotiation at VERIFIED, one step short (#876). Up to 90 s, every 5 s.
  if (bru.getEnvVar("dspLiveFlow") === "true") {
    const axios = require("axios");
    const headers = {
      Cookie: `${bru.getEnvVar("cookieName")}=${bru.getEnvVar("sessionTokenResearcher")}`,
    };
    const url = `${bru.getEnvVar("baseUrl")}/api/negotiations?participantId=${bru.getVar("dspConsumerCtx")}`;
    for (let i = 0; i < 18; i++) {
      await new Promise((resolve) => setTimeout(resolve, 5000));
      const rows = (await axios.get(url, { headers, validateStatus: () => true })).data;
      const row = Array.isArray(rows) ? rows.find((r) => r["@id"] === bru.getVar("dspNegotiationId")) : null;
      if (row && ["FINALIZED", "TERMINATED"].includes(row.state)) break;
    }
  }
}

assert {
  res.status: eq 200
  res.body: isArray
}

tests {
  const row = res.getBody().find((n) => n["@id"] === bru.getVar("dspNegotiationId")) || {};
  bru.setVar("dspAgreementId", row.contractAgreementId || "");
  if (bru.getEnvVar("dspLiveFlow") !== "true") {
    test("SKIPPED live check: this environment does not run the DSP flow end to end (#542)", function () {});
  } else {
    test("FINALIZED with a contract agreement", function () {
      expect(row.state, `negotiation ${bru.getVar("dspNegotiationId")}: ${row.errorDetail || "not listed"}`).to.equal("FINALIZED");
      expect(row.contractAgreementId, "no agreement").to.be.a("string").that.is.not.empty;
    });
  }
}
