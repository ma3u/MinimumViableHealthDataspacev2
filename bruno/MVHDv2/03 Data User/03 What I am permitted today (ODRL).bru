meta {
  name: 03 What I am permitted today (ODRL)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/odrl/scope
  body: none
  auth: inherit
}

headers {
  Cookie: {{cookieName}}={{sessionTokenResearcher}}
}

assert {
  res.status: eq 200
  res.body.permissions: isArray
  res.body.prohibitions: isArray
  res.body.participantId: isDefined
  res.body.participantId: eq did:web:pharmaco.de:research
}

tests {
  test("permissions is not empty", function () {
    expect(res.getBody().permissions).to.not.be.empty;
  });
}
