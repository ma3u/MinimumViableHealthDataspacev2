meta {
  name: 15 A dataset without a title (400)
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/catalog
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Cookie: {{cookieName}}={{sessionTokenClinic}}
}

body:json {
  {}
}

assert {
  res.status: eq 400
  res.body.error: contains id and title
}
