meta {
  name: 03 How the components connect
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/admin/components/topology
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("participants is not empty", function () {
    expect(res.getBody().participants).to.not.be.empty;
  });
  test("infrastructure is not empty", function () {
    expect(res.getBody().infrastructure).to.not.be.empty;
  });
}
