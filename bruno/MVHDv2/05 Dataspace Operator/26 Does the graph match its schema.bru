meta {
  name: 26 Does the graph match its schema
  type: http
  seq: 26
}

get {
  url: {{baseUrl}}/api/graph/validate
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.summary: isDefined
  res.body.nodeCounts: isDefined
}

tests {
  test("nodeCounts is not empty", function () {
    expect(res.getBody().nodeCounts).to.not.be.empty;
  });
}
