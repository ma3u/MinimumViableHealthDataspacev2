meta {
  name: 08 Deregister the one I just registered
  type: http
  seq: 8
}

delete {
  url: {{baseUrl}}/api/admin/participants?id=did:web:bruno.example:probe
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.ok: eq true
  res.body.seeded: eq false
}

docs {
  Only ever the participant this folder created. A seeded participant can be deleted as well since
  2026-10-04; the answer then says `seeded: true` and the next deploy re-seeds it. This request
  must never touch one, because the suites that follow read the seeded graph.
}
