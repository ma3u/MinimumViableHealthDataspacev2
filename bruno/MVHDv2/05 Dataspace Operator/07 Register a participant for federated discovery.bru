meta {
  name: 07 Register a participant for federated discovery
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/admin/participants
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "participantId": "did:web:bruno.example:probe",
    "name": "Bruno probe clinic",
    "participantType": "HealthcareProvider",
    "country": "DE",
    "source": "business-wallet",
    "walletType": "business",
    "dspCatalogUrl": "https://bruno.example/api/dsp",
    "crawlerEnabled": false
  }
}

assert {
  res.status: eq 201
  res.body.ok: eq true
  res.body.participantId: eq did:web:bruno.example:probe
}
