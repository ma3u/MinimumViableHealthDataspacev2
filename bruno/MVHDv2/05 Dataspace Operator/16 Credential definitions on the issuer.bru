meta {
  name: 16 Credential definitions on the issuer
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/api/credentials/definitions
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.definitions: isArray
}

tests {
  test("definitions is not empty", function () {
    expect(res.getBody().definitions).to.not.be.empty;
  });
}
