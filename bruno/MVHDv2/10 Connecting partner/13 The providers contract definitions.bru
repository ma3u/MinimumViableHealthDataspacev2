meta {
  name: 13 The provider's contract definitions
  type: http
  seq: 6
}

post {
  url: {{mgmtUrl}}/{{mgmtVersion}}/participants/{{providerCtx}}/contractdefinitions/request
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Cookie: {{cookieName}}=not-a-session
}

auth:bearer {
  token: {{edcToken}}
}

body:json {
  {
    "@context": [
      "https://w3id.org/edc/connector/management/v2"
    ],
    "@type": "QuerySpec"
  }
}

assert {
  res.status: eq 200
  res.body: isArray
}
