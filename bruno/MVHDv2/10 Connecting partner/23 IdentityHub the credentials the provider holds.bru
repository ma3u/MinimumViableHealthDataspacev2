meta {
  name: 23 IdentityHub the credentials the provider holds
  type: http
  seq: 13
}

get {
  url: {{identityUrl}}/v1alpha/participants/{{providerCtx}}/credentials
  body: none
  auth: bearer
}

headers {
  Cookie: {{cookieName}}=not-a-session
}

auth:bearer {
  token: {{edcToken}}
}

assert {
  res.status: eq 200
  res.body: isArray
}

tests {
  test("captures how many credentials the provider holds now", function () {
    bru.setVar("credentialsBefore", String(res.getBody().length));
  });
}
