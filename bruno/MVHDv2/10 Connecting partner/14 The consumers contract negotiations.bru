meta {
  name: 14 The consumer's contract negotiations
  type: http
  seq: 7
}

post {
  url: {{mgmtUrl}}/{{mgmtVersion}}/participants/{{consumerCtx}}/contractnegotiations/request
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Cookie: {{cookieName}}=not-a-session
}

auth:bearer {
  token: {{edcToken}}
}

body:json {
  {
    "@context": [
      "https://w3id.org/edc/connector/management/v2"
    ],
    "@type": "QuerySpec"
  }
}

assert {
  res.status: eq 200
  res.body: isArray
}

tests {
  test("captures a negotiation the control plane really holds", function () {
    const rows = res.getBody();
    bru.setVar("realNegotiationId", rows.length ? rows[0]["@id"] : "");
  });
}
