meta {
  name: 30 IssuerService credential definitions
  type: http
  seq: 14
}

post {
  url: {{issuerUrl}}/v1/participants/issuer/credentialdefinitions/query
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Cookie: {{cookieName}}=not-a-session
}

auth:bearer {
  token: {{issuerToken}}
}

body:json {
  {}
}

assert {
  res.status: eq 200
  res.body: isArray
  res.body[0].id: isDefined
}

tests {
  test("captures the MembershipCredential definition id", function () {
    const defs = res.getBody();
    const def = defs.find((d) => (d.credentialType || "") === "MembershipCredential") || defs[0];
    expect(def, "the issuer has no credential definition to request").to.not.equal(undefined);
    bru.setVar("membershipDefinitionId", def.id);
    // the request names the definition's format: from IdentityHub 1.0.0-RC6 it is the issuer's DCP
    // profile's (VC2_0_JOSE by default, IdentityHub #1248), and the holder refuses a delivery whose
    // format differs from its request
    bru.setVar("membershipDefinitionFormat", def.format || "VC1_0_JWT");
  });
}

docs {
  The issuer resolves a request by definition id, not by type; the type alone answers 400 'Credential definition ID null does not exist'.
}
