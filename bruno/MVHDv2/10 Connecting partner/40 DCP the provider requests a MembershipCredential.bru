meta {
  name: 40 DCP the provider requests a MembershipCredential
  type: http
  seq: 18
}

post {
  url: {{identityUrl}}/v1alpha/participants/{{providerCtx}}/credentials/request
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Cookie: {{cookieName}}=not-a-session
}

auth:bearer {
  token: {{edcToken}}
}

body:json {
  {
    "issuerDid": "{{issuerDid}}",
    "credentials": [
      {
        "id": "{{membershipDefinitionId}}",
        "type": "MembershipCredential",
        "format": "VC1_0_JWT"
      }
    ]
  }
}

assert {
  res.status: gte 200
  res.status: lt 300
}

docs {
  The holder's IdentityHub sends a CredentialRequestMessage; the issuer approves it and delivers
  to the CredentialService endpoint in the holder's DID document. Without that endpoint the process
  sits at APPROVED forever, which is what CI did until #345.
}
