meta {
  name: 16 DSP the consumer asks for the provider's catalogue
  type: http
  seq: 9
}

post {
  url: {{mgmtUrl}}/{{mgmtVersion}}/participants/{{consumerCtx}}/catalog/request
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Cookie: {{cookieName}}=not-a-session
}

auth:bearer {
  token: {{edcToken}}
}

body:json {
  {
    "@context": [
      "https://w3id.org/edc/connector/management/v2"
    ],
    "@type": "CatalogRequest",
    "counterPartyAddress": "{{dspInternalUrl}}/{{providerCtx}}/http-dsp-profile-2025-1",
    "counterPartyId": "{{providerDid}}",
    "protocol": "http-dsp-profile-2025-1"
  }
}

assert {
  res.status: eq 200
  res.body['@type']: isDefined
}

docs {
  The consumer's control plane sends a DSP CatalogRequestMessage to the provider and returns
  the provider's catalogue. The protocol is the profile id, `http-dsp-profile-2025-1`, and the
  provider's address ends in it (#542). Red from 2026-09-26 to 2026-10-28: the request named
  `dataspace-protocol-http:2025-1`, for which no dispatcher is registered (#345), and in CI the
  consumer's context had no STS config, so the call could not have left anyway (#710).
}
