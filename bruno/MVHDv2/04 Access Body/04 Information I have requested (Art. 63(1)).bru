meta {
  name: 04 Information I have requested (Art. 63(1))
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/compliance/information-requests
  body: none
  auth: inherit
}

headers {
  Cookie: {{cookieName}}={{sessionTokenRegulator}}
}

assert {
  res.status: eq 200
  res.body.requests: isArray
  res.body.article: contains 2025/327
}

tests {
  test("information requests are on record", function () {
    expect(res.getBody().requests, "requests").to.be.an("array").that.is.not.empty;
  });
}
