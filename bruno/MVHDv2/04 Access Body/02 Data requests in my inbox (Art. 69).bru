meta {
  name: 02 Data requests in my inbox (Art. 69)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/compliance/requests
  body: none
  auth: inherit
}

headers {
  Cookie: {{cookieName}}={{sessionTokenRegulator}}
}

assert {
  res.status: eq 200
  res.body.requests: isArray
  res.body.article: contains 2025/327
}

tests {
  test("the inbox holds data requests", function () {
    expect(res.getBody().requests, "requests").to.be.an("array").that.is.not.empty;
  });
}
