meta {
  name: 05 The compliance matrix I report from
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/compliance
  body: none
  auth: inherit
}

headers {
  Cookie: {{cookieName}}={{sessionTokenRegulator}}
}

assert {
  res.status: eq 200
  res.body.matrix: isArray
  res.body.datasets: isArray
  res.body.consumers: isArray
}
