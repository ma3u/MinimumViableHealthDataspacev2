meta {
  name: 08 The retention rule on that trail (Art. 73(1)(e))
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/admin/audit/retention
  body: none
  auth: inherit
}

headers {
  Cookie: {{cookieName}}={{sessionTokenRegulator}}
}

assert {
  res.status: eq 200
}

tests {
  test("a retention policy is stated, not merely a JSON body", function () {
    expect(res.getBody().policy, "policy").to.be.an("object");
  });
}
