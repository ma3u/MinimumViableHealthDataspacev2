meta {
  name: 03 Findings I have opened (Art. 63)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/compliance/findings
  body: none
  auth: inherit
}

headers {
  Cookie: {{cookieName}}={{sessionTokenRegulator}}
}

assert {
  res.status: eq 200
  res.body.findings: isArray
  res.body.article: contains 2025/327
}

tests {
  test("the access body has findings on record", function () {
    expect(res.getBody().findings, "findings").to.be.an("array").that.is.not.empty;
  });
}
