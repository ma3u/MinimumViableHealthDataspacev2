meta {
  name: 28 participants
  type: http
  seq: 28
}

get {
  url: {{baseUrl}}/mock/participants.json
  body: none
  auth: inherit
}

headers {
  Cookie: {{cookieName}}=not-a-session
}

assert {
  res.status: eq 200
  res.body: isArray
  res.body[0]: isDefined
}

docs {
  ui/public/mock/participants.json stands in for /api/participants in the static build.
}
