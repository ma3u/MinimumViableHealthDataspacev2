meta {
  name: 09 catalog
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/mock/catalog.json
  body: none
  auth: inherit
}

headers {
  Cookie: {{cookieName}}=not-a-session
}

assert {
  res.status: eq 200
  res.body: isArray
  res.body[0].id: isDefined
  res.body[0].title: isDefined
}

tests {
  // #782: the static catalogue carries the German descriptions too.
  test("datasets carry a German title", function () {
    const german = res.getBody().filter((d) => d.translations && d.translations.de);
    expect(german.length).to.be.above(0);
  });
}

docs {
  ui/public/mock/catalog.json stands in for /api/catalog in the static build.
}
