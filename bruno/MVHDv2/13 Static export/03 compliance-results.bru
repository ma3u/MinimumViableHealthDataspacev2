meta {
  name: 03 compliance/results
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/mock/results.json
  body: none
  auth: inherit
}

headers {
  Cookie: {{cookieName}}=not-a-session
}

assert {
  res.status: eq 200
  res.body.results: isArray
}

docs {
  ui/public/mock/results.json stands in for /api/compliance/results in the static build.
}
