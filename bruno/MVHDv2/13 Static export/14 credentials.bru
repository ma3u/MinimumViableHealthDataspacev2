meta {
  name: 14 credentials
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/mock/credentials.json
  body: none
  auth: inherit
}

headers {
  Cookie: {{cookieName}}=not-a-session
}

assert {
  res.status: eq 200
  res.body.credentials: isArray
}

docs {
  ui/public/mock/credentials.json stands in for /api/credentials in the static build.
}
