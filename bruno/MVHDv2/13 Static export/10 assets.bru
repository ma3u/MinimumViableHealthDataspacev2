meta {
  name: 10 assets
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/mock/assets.json
  body: none
  auth: inherit
}

headers {
  Cookie: {{cookieName}}=not-a-session
}

assert {
  res.status: eq 200
  res.body: isArray
}

docs {
  ui/public/mock/assets.json stands in for /api/assets in the static build.
}
