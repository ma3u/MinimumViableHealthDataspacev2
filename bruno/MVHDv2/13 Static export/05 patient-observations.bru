meta {
  name: 05 patient/observations
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/mock/patient_observations.json
  body: none
  auth: inherit
}

headers {
  Cookie: {{cookieName}}=not-a-session
}

assert {
  res.status: eq 200
  res.body.resourceType: eq Bundle
  res.body.entry: isArray
}

docs {
  ui/public/mock/patient_observations.json stands in for /api/patient/observations in the static build.
}
