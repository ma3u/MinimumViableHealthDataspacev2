meta {
  name: 01 Data user asks a question (Art. 69)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/compliance/requests
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Cookie: {{cookieName}}={{sessionTokenResearcher}}
}

body:json {
  {
    "question": "How many patients with type 2 diabetes had an HbA1c above 9 percent in 2024?",
    "purpose": "SCIENTIFIC_RESEARCH",
    "statisticalContent": "One count, k-anonymity threshold 5",
    "datasetId": "{{datasetId}}",
    "safeguards": "aggregate only",
    "legalBasis": "Regulation (EU) 2025/327, Art. 69"
  }
}

assert {
  res.status: eq 201
  res.body.requestId: isDefined
  res.body.status: isDefined
}

tests {
  test("captures dataRequestId", function () {
    bru.setVar("dataRequestId", res.getBody().requestId);
  });
}
