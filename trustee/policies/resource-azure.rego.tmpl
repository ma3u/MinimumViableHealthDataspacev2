# KBS resource policy, mvhd-trustee on Azure ("Attested: confidential workload")
#
# Releases an SPE's extract key, default/spe-<n>/extract-key, only to
#   - SEV-SNP evidence (Trustee's `snp` verifier checked the report against
#     AMD's VCEK chain) from an ACI confidential container group,
#   - whose attestation token is affirming, every submodule,
#   - whose launch measurement matched a pinned reference value: the
#     `executables` claim is in AR4SI's affirming tier (2 to 31) only when
#     snp_launch_measurement is set in RVPS and matches; with no pin it is 33
#     and nothing is released (no unlock on first use),
#   - and whose HOST_DATA is the permit's policy hash for that SPE: on ACI,
#     HOST_DATA is the SHA-256 of the group's ccePolicy, so a workload with
#     another image, command or environment gets nothing (ADR-068 decision 2).
# Sample evidence, which any container can produce, gets nothing here.
#
# Where the claims are (Trustee v0.22.0, checked against its source):
#   input.submods.cpu0["ear.veraison.annotated-evidence"].snp       the report's claims
#   input.submods.cpu0["ear.veraison.annotated-evidence"].init_data HOST_DATA, hex:
#     the snp verifier emits it as `init_data` (deps/verifier/src/snp/mod.rs)
#     and transform_claims moves it out of `snp` to this level
#     (attestation-service/src/ear_token/broker.rs)
#   input.submods.cpu0["ear.trustworthiness-vector"].executables
#
# A template: `spe-loader trustee-configure --resource-policy-template` fills
# in the line below with the hashes 21-aci-confidential-spe.sh --policy
# recorded, one per SPE, without the `sha256:` prefix. Tests:
# resource_azure_test.rego (scripts/test-trustee-policies.sh).
package policy

import rego.v1

default allow := false

permit_policy_hash := {}

spe := data["resource-path"][1]

spe_extract_key if {
	data.plugin == "resource"
	count(data["resource-path"]) == 3
	data["resource-path"][0] == "default"
	regex.match(`^spe-[0-9]+$`, spe)
	data["resource-path"][2] == "extract-key"
}

snp_appraisals contains sub if {
	some _, sub in input.submods
	sub["ear.veraison.annotated-evidence"].snp
}

sample_evidence if {
	some _, sub in input.submods
	sub["ear.veraison.annotated-evidence"].sample
}

affirming if {
	count(input.submods) > 0
	not any_not_affirming
}

any_not_affirming if {
	some _, sub in input.submods
	sub["ear.status"] != "affirming"
}

measurement_pinned if {
	some sub in snp_appraisals
	executables := sub["ear.trustworthiness-vector"].executables
	executables >= 2
	executables <= 31
}

host_data_is_the_permits if {
	some sub in snp_appraisals
	lower(sub["ear.veraison.annotated-evidence"].init_data) == permit_policy_hash[spe]
}

allow if {
	spe_extract_key
	count(snp_appraisals) > 0
	not sample_evidence
	affirming
	measurement_pinned
	host_data_is_the_permits
}
