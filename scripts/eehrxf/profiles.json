{
  "$comment": "The one place that says which EEHRxF guides and profiles the hub tracks (#1144). validate.py validates against these, build.py writes neo4j/register-eehrxf-profiles.cypher and ui/public/mock/eehrxf.json from them. Versions checked against each guide's package-list.json on 2026-11-17.",
  "validator": {
    "name": "HL7 FHIR Validator",
    "version": "7.0.5",
    "url": "https://github.com/hapifhir/org.hl7.fhir.core/releases/download/7.0.5/validator_cli.jar",
    "fhirVersion": "4.0.1",
    "terminology": "not checked: run with -tx n/a, so codes are checked for shape, not against SNOMED CT, LOINC or the IG value sets",
    "allowedExtensionDomains": [
      "https://ehds.mabu.red/fhir/",
      "http://synthetichealth.github.io/synthea/"
    ],
    "allowedExtensionReason": "Our own extensions and Synthea's are defined by their authors but published nowhere the validator can load, so they are allowed by domain. Every other unknown extension (US Core, for example) stays an error.",
    "ignoredIssues": [
      {
        "contains": "conditional references are only valid inside a transaction Bundle",
        "sources": ["synthea"],
        "reason": "Synthea writes conditional references to practitioners and organisations inside its transaction Bundle. The sample lifts resources out of that Bundle, so the rule cannot hold there; scripts/load_fhir_neo4j.py reads them inside it."
      }
    ]
  },
