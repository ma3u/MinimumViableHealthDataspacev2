{
  "name": "@health-dataspace/neo4j-proxy",
  "version": "0.1.0",
  "description": "Neo4j Query Proxy — bridges DCore data planes to Neo4j graph (ADR-2)",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node --import ./dist/tracing.js dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-express": "^0.70.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "neo4j-driver": "^5.28.1",
    "pg": "^8.23.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "qs": "^6.16.0"
  }
}
