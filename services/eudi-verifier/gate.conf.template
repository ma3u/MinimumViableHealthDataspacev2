# The public face of the self-hosted verifier (ADR-066). A wallet needs the
# /wallet/* API and nothing else: the signed request it fetches, the key it
# encrypts its answer to, and the endpoint it posts that answer to. Everything
# else the verifier serves, above all /ui/presentations, which starts a
# request signed with our access certificate, stays on the internal port the
# hub calls. Exposed, anyone could ask a citizen's wallet for a PID in our name.
#
# VERIFIER_UPSTREAM is the verifier container: eudi-verifier:8080 in compose,
# localhost:8080 inside the Container App (both containers share a replica).
# d-you fetches the signed request twice: once to show who is asking, then
# again when the person presses Next (#708, 2026-10-28). The verifier hands a
# request out once and answers the second fetch 400, so the gate keeps the
# first answer and serves the identical object again. Only GETs of
# /wallet/request.jwt/* are kept, for ten minutes, and nothing the wallet
# sends back is cached.
proxy_cache_path /tmp/jar-cache levels=1 keys_zone=jar:1m max_size=10m inactive=10m use_temp_path=off;

server {
    listen 8081;
    server_tokens off;
    client_max_body_size 512k;

    location /wallet/request.jwt/ {
        limit_except GET POST { deny all; }
        proxy_pass http://${VERIFIER_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache jar;
        proxy_cache_methods GET;
        proxy_cache_key $request_uri;
        proxy_cache_valid 200 10m;
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
        proxy_cache_lock on;
        add_header X-Gate-Cache $upstream_cache_status always;
    }

    location /wallet/ {
        limit_except GET POST { deny all; }
        proxy_pass http://${VERIFIER_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 404;
    }
}
