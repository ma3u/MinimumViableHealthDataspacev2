# The public face of the self-hosted verifier (ADR-066). A wallet needs the
# /wallet/* API and nothing else: the signed request it fetches, the key it
# encrypts its answer to, and the endpoint it posts that answer to. Everything
# else the verifier serves, above all /ui/presentations, which starts a
# request signed with our access certificate, stays on the internal port the
# hub calls. Exposed, anyone could ask a citizen's wallet for a PID in our name.
#
# VERIFIER_UPSTREAM is the verifier container: eudi-verifier:8080 in compose,
# localhost:8080 inside the Container App (both containers share a replica).
server {
    listen 8081;
    server_tokens off;
    client_max_body_size 512k;

    location /wallet/ {
        limit_except GET POST { deny all; }
        proxy_pass http://${VERIFIER_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 404;
    }
}
