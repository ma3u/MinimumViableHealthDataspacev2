{
  "uid": "mvhd-ehds-audit",
  "title": "EHDS audit trail",
  "description": "Integrity and content of the regulatory audit trail (ADR-045 plane 2).",
  "tags": ["ehds", "audit", "mvhd"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
