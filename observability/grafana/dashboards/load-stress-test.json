{
  "uid": "mvhd-load-test",
  "title": "Load and stress test",
  "description": "What to watch while k6 runs against the hub (#519): load, client-side response time by kind and endpoint, the proxy's own view of the same run, and which container saturates first.",
  "tags": ["mvhd", "load-test", "k6"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Load (k6): what the test is doing",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Virtual users",
      "description": "Concurrent users right now.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(k6_vus{testid=\"$testid\"})",
          "legendFormat": "",
          "refId": "A"
