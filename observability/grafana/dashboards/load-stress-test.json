      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {service_name=~\".*neo4j-proxy.*\"} | json | __error__=\"\" | load_test=\"$testid\" | unwrap duration_ms [$__auto]) by (route)",
