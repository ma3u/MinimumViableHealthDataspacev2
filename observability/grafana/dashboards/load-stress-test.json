        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (status) (count_over_time({service_name=~\".*neo4j-proxy.*\"} | json | __error__=\"\" | load_test=\"$testid\" [1m]))",
          "legendFormat": "{{status}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
