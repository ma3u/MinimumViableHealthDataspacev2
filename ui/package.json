{
  "name": "health-dataspace-ui",
  "version": "2.0.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "postinstall": "sh scripts/setup-env.sh && sh scripts/copy-swagger-ui.sh",
    "clean": "rm -rf .next",
    "dev": "next dev",
    "dev:clean": "npm run clean && next dev",
    "predev": "rm -rf .next/cache/webpack && sh scripts/copy-swagger-ui.sh",
    "prebuild": "sh scripts/copy-swagger-ui.sh",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "knip": "knip --no-progress",
    "generate:api": "../scripts/generate-api-types.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:ui": "playwright test --config playwright.config.ts --ui"
  },
  "overrides": {
    "neverpanic": "^0.0.7",
    "fast-uri": "^3.1.2",
    "postcss": "^8.5.28",
    "katex": "0.18.10"
  },
  "dependencies": {
    "@scalar/api-reference-react": "^0.9.83",
    "3d-force-graph": "^1.80.1",
    "jose": "^6.2.13",
    "lucide-react": "^0.577.0",
    "marked": "^18.1.1",
    "mermaid": "^11.13.0",
    "neo4j-driver": "^5.18.0",
    "next": "^15.5.28",
    "next-auth": "^4.24.13",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "react-force-graph-2d": "^1.29.2",
    "swagger-ui-dist": "^5.34.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.57.2",
    "@typescript-eslint/typescript-estree": "^8.57.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^8",
    "eslint-config-next": "^15.5.28",
    "jsdom": "^30.1.3",
    "knip": "6.43.0",
    "lightningcss": "1.33.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "optionalDependencies": {
    "@next/swc-linux-arm64-musl": "^16.4.3"
  }
