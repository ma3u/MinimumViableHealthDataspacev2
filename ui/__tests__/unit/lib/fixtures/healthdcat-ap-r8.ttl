    csvw:table <https://ehds.mabu.red/catalog/variables/vars%3Afhir-r4%3ACondition> .

<https://ehds.mabu.red/catalog/variables/vars%3Afhir-r4%3ACondition>
    a csvw:Table ;
    dct:title "Condition" ;
    csvw:column <https://ehds.mabu.red/catalog/variables/vars%3Afhir-r4%3ACondition#code>, <https://ehds.mabu.red/catalog/variables/vars%3Afhir-r4%3ACondition#onsetDateTime> .

<https://ehds.mabu.red/catalog/variables/vars%3Afhir-r4%3ACondition#code>
    a csvw:Column ;
    csvw:name "code" ;
    csvw:title "Diagnosis code" ;
    dct:description "SNOMED CT or ICD-10 code of the condition" ;
    csvw:datatype "string" .

<https://ehds.mabu.red/catalog/variables/vars%3Afhir-r4%3ACondition#onsetDateTime>
    a csvw:Column ;
    csvw:name "onsetDateTime" ;
    csvw:title "Onset" ;
    dct:description "When the condition began" ;
    csvw:datatype "dateTime" .

