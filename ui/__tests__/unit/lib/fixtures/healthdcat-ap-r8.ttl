<https://ehds.mabu.red/catalog>
    a dcat:Catalog ;
    dct:title "EHDS integration hub, HealthDCAT-AP catalogue" ;
    dct:description "Health datasets of the hub, described in HealthDCAT-AP Release 8. All are synthetic." ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
    dct:publisher <https://ehds.mabu.red/agents/operator> ;
    dct:conformsTo <https://data.health.europa.eu/healthdcat-ap/releases/release-8/> ;
    dcat:themeTaxonomy <http://publications.europa.eu/resource/authority/data-theme> ;
    dcat:dataset <https://ehds.mabu.red/catalog/datasets/dataset%3Aalpha-klinik-cardio-registry>, <https://ehds.mabu.red/catalog/datasets/dataset%3Almc-omop-analytics> .

<http://data.europa.eu/eli/reg/2025/327/oj>
    a eli:LegalResource .

<https://ehds.mabu.red/agents/operator>
    a foaf:Agent ;
    foaf:name "EHDS integration hub operator" .

<https://ehds.mabu.red/catalog/datasets/dataset%3Aalpha-klinik-cardio-registry>
    a dcat:Dataset ;
    dct:identifier "dataset:alpha-klinik-cardio-registry" ;
    dct:title "AlphaKlinik Berlin Cardiac Registry" ;
    dct:description "Synthetic registry of cardiac outcomes at AlphaKlinik Berlin, FHIR R4." ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC> ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
    dct:type <http://publications.europa.eu/resource/authority/dataset-type/SYNTHETIC_DATA> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL> ;
    dcat:keyword "Cardiology", "RegistryData", "synthetic data", "EHDS secondary use" ;
    dct:provenance [ a dct:ProvenanceStatement ; rdfs:label "Synthetic data generated for the EHDS integration hub; it describes no real person." ] ;
    healthdcatap:healthCategory <https://hdeu-dcat.data.health.europa.eu/resource/authority/healthcategories/EHRS>, <https://hdeu-dcat.data.health.europa.eu/resource/authority/healthcategories/MRMR> ;
    healthdcatap:healthTheme <https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/NONCOMMUNICABLE_DISEASES> ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dcat:landingPage <https://ehds.mabu.red/data/discover?dataset=dataset%3Aalpha-klinik-cardio-registry> ;
    dpv:hasPurpose <https://w3id.org/dpv#ScientificResearch> ;
    dpv:hasLegalBasis <https://ehds.mabu.red/legal-basis/ehds-data-permit> ;
    healthdcatap:hasCodingSystem <https://hdeu-dcat.data.health.europa.eu/resource/authority/coding-system/SNOMED-CT>, <https://hdeu-dcat.data.health.europa.eu/resource/authority/coding-system/LOINC>, <https://hdeu-dcat.data.health.europa.eu/resource/authority/coding-system/ICD-10>, <https://hdeu-dcat.data.health.europa.eu/resource/authority/coding-system/RXNORM> ;
    healthdcatap:hasStructuredData "true"^^xsd:boolean ;
    healthdcatap:numberOfRecords "4200"^^xsd:nonNegativeInteger ;
    healthdcatap:numberOfUniqueIndividuals "1200"^^xsd:nonNegativeInteger ;
    healthdcatap:minTypicalAge "18"^^xsd:nonNegativeInteger ;
    healthdcatap:maxTypicalAge "90"^^xsd:nonNegativeInteger ;
    dct:temporal [ a dct:PeriodOfTime ; dcat:startDate "2020-01-01"^^xsd:date ; dcat:endDate "2025-12-31"^^xsd:date ] ;
    healthdcatap:retentionPeriod [ a dct:PeriodOfTime ; dcat:startDate "2020-01-01"^^xsd:date ; dcat:endDate "2035-12-31"^^xsd:date ] ;
    healthdcatap:populationCoverage "Synthetic adults after an acute coronary syndrome, Berlin"@en ;
    healthdcatap:hasCodeValues "ICD-10:I21", "ICD-10:I50" ;
    dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/IRREG> ;
    dcat:temporalResolution "P1D"^^xsd:duration ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    foaf:page <https://ma3u.github.io/MinimumViableHealthDataspacev2/docs/ehds> ;
    dct:issued "2026-01-15" ;
    dct:conformsTo <https://hdeu-dcat.data.health.europa.eu/resource/authority/standard/FHIR> ;
    healthdcatap:analytics [ a dcat:Distribution ; dct:title "Aggregate statistics of the hub's OMOP CDM data, which include this dataset" ; dcat:accessURL <https://ehds.mabu.red/analytics> ; dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ] ;
    healthdcatap:hasVariables <https://ehds.mabu.red/catalog/variables/vars%3Afhir-r4> ;
    healthdcatap:hdab <did:web:medreg.de:hdab> ;
    geodcatap:custodian <did:web:alpha-klinik.de:participant> ;
    dct:publisher <did:web:alpha-klinik.de:participant> ;
    dcat:contactPoint [ a vcard:Kind ; vcard:fn "AlphaKlinik Berlin data access desk" ; vcard:hasEmail <mailto:data-access@alphaklinik-berlin.example> ] ;
    dcat:distribution [ a dcat:Distribution ; dcat:accessURL <https://ehds.mabu.red/data/discover?dataset=dataset%3Aalpha-klinik-cardio-registry> ; dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ; dcat:mediaType <https://www.iana.org/assignments/media-types/application/fhir+json> ; dct:format <http://publications.europa.eu/resource/authority/file-type/JSON> ; dct:conformsTo <https://hdeu-dcat.data.health.europa.eu/resource/authority/standard/FHIR> ; dct:title "FHIR R4 Bundle" ; dct:description "Reached through the health data access body, under a data permit (Regulation (EU) 2025/327, Art. 68)" ; dcatap:availability <http://publications.europa.eu/resource/authority/planned-availability/STABLE> ] .

